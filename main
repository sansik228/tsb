    FloatingSub.TextSize = 11
    FloatingSub.TextColor3 = Sansik.Theme.TextSecondary
    FloatingSub.BackgroundTransparency = 1
    FloatingSub.TextXAlignment = Enum.TextXAlignment.Left
    FloatingSub.Position = UDim2.new(0, 56, 0, 26)
    FloatingSub.Size = UDim2.new(1, -70, 0, 14)
    FloatingSub.ZIndex = 901
    FloatingSub.Parent = FloatingBtn

    Main.DescendantAdded:Connect(function(desc)
        task.defer(function()
            if desc:IsA("Frame") or desc:IsA("TextButton") or desc:IsA("ImageButton") then
                if desc:GetAttribute("_bgOrig") == nil then
                    desc:SetAttribute("_bgOrig", desc.BackgroundTransparency)
                end
            end
            if desc:IsA("TextLabel") or desc:IsA("TextBox") then
                if desc:GetAttribute("_txtOrig") == nil then
                    desc:SetAttribute("_txtOrig", desc.TextTransparency)
                end
            end
            if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                if desc:GetAttribute("_imgOrig") == nil then
                    desc:SetAttribute("_imgOrig", desc.ImageTransparency)
                end
            end
            if desc:IsA("UIStroke") then
                if desc:GetAttribute("_strokeOrig") == nil then
                    desc:SetAttribute("_strokeOrig", desc.Transparency)
                end
            end
            if desc:IsA("ScrollingFrame") then
                if desc:GetAttribute("_scrollBarOrig") == nil then
                    desc:SetAttribute("_scrollBarOrig", desc.ScrollBarImageTransparency)
                end
            end
        end)
    end)

    cacheTransparencies(Main)

    local NotifFrame = Instance.new("Frame")
    NotifFrame.Size = UDim2.new(0, 280, 1, -40)
    NotifFrame.Position = UDim2.new(1, -300, 0, 20)
    NotifFrame.BackgroundTransparency = 1
    NotifFrame.Parent = ScreenGui

    local NotifLayout = Instance.new("UIListLayout")
    NotifLayout.Padding = UDim.new(0, 8)
    NotifLayout.SortOrder = Enum.SortOrder.LayoutOrder
    NotifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    NotifLayout.Parent = NotifFrame

    local Window = {}
    local currentTab = nil
    local openDropdownList = nil
    local openColorPicker = nil
    local isHidden = false
    local isAnimating = false

    -- Регистрируем окно в списке
    table.insert(Sansik.Windows, {window = Window, main = Main, floating = FloatingBtn})

    function Window:Notify(props)
        props = props or {}
        local duration = props.duration or 4

        local notif = Instance.new("Frame")
        notif.Size = UDim2.new(1, 0, 0, 0)
        notif.BackgroundColor3 = Sansik.Theme.NotificationBackground
        notif.BorderSizePixel = 0
        notif.Parent = NotifFrame
        notif.BackgroundTransparency = 1
        notif.ClipsDescendants = true
        corner(notif, 10)
        stroke(notif, Sansik.Theme.ElementStroke, 1, 0.5)

        local accentBar = Instance.new("Frame")
        accentBar.Size = UDim2.new(0, 3, 1, -16)
        accentBar.Position = UDim2.new(0, 8, 0, 8)
        accentBar.BackgroundColor3 = props.accent or Sansik.Theme.Accent
        accentBar.BorderSizePixel = 0
        accentBar.ZIndex = 2
        accentBar.Parent = notif
        corner(accentBar, 2)

        local iconFrame = Instance.new("Frame")
        iconFrame.Size = UDim2.new(0, 28, 0, 28)
        iconFrame.Position = UDim2.new(0, 18, 0, 14)
        iconFrame.BackgroundColor3 = props.accent or Sansik.Theme.Accent
        iconFrame.BackgroundTransparency = 0.85
        iconFrame.BorderSizePixel = 0
        iconFrame.ZIndex = 2
        iconFrame.Parent = notif
        corner(iconFrame, 8)

        local iconImg = Instance.new("ImageLabel")
        iconImg.Size = UDim2.new(0, 16, 0, 16)
        iconImg.Position = UDim2.new(0.5, -8, 0.5, -8)
        iconImg.BackgroundTransparency = 1
        iconImg.ImageColor3 = props.accent or Sansik.Theme.Accent
        iconImg.ZIndex = 3
        iconImg.Parent = iconFrame
        local ico = getIcon(props.icon or "info")
        if ico then
            iconImg.Image = ico.id
            if ico.rectOffset then iconImg.ImageRectOffset = ico.rectOffset end
            if ico.rectSize then iconImg.ImageRectSize = ico.rectSize end
        end

        local NotifTitle = Instance.new("TextLabel")
        NotifTitle.Text = props.title or "Notification"
        NotifTitle.Font = Enum.Font.GothamBold
        NotifTitle.TextSize = 13
        NotifTitle.TextColor3 = Sansik.Theme.TextColor
        NotifTitle.BackgroundTransparency = 1
        NotifTitle.TextXAlignment = Enum.TextXAlignment.Left
        NotifTitle.Position = UDim2.new(0, 58, 0, 12)
        NotifTitle.Size = UDim2.new(1, -100, 0, 16)
        NotifTitle.TextTransparency = 1
        NotifTitle.ZIndex = 2
        NotifTitle.Parent = notif

        local NotifContent = Instance.new("TextLabel")
        NotifContent.Text = props.content or ""
        NotifContent.Font = Enum.Font.Gotham
        NotifContent.TextSize = 11
        NotifContent.TextColor3 = Sansik.Theme.TextSecondary
        NotifContent.BackgroundTransparency = 1
        NotifContent.TextXAlignment = Enum.TextXAlignment.Left
        NotifContent.TextWrapped = true
        NotifContent.TextYAlignment = Enum.TextYAlignment.Top
        NotifContent.Position = UDim2.new(0, 58, 0, 32)
        NotifContent.Size = UDim2.new(1, -70, 0, 30)
        NotifContent.TextTransparency = 1
        NotifContent.ZIndex = 2
        NotifContent.Parent = notif

        local closeBtn = Instance.new("ImageButton")
        closeBtn.Size = UDim2.new(0, 22, 0, 22)
        closeBtn.Position = UDim2.new(1, -30, 0, 10)
        closeBtn.BackgroundTransparency = 1
        closeBtn.ZIndex = 4
        closeBtn.Parent = notif
        corner(closeBtn, 6)
        local closeIco = getIcon("x")
        if closeIco then
            closeBtn.Image = closeIco.id
            if closeIco.rectOffset then closeBtn.ImageRectOffset = closeIco.rectOffset end
            if closeIco.rectSize then closeBtn.ImageRectSize = closeIco.rectSize end
            closeBtn.ImageColor3 = Sansik.Theme.TextSecondary
        end
        closeBtn.ImageTransparency = 1

        local progressBg = Instance.new("Frame")
        progressBg.Size = UDim2.new(1, -16, 0, 2)
        progressBg.Position = UDim2.new(0, 8, 1, -8)
        progressBg.BackgroundColor3 = Sansik.Theme.ElementStroke
        progressBg.BorderSizePixel = 0
        progressBg.BackgroundTransparency = 0.6
        progressBg.ZIndex = 2
        progressBg.Parent = notif
        corner(progressBg, 1)

        local progressFill = Instance.new("Frame")
        progressFill.Size = UDim2.new(1, 0, 1, 0)
        progressFill.BackgroundColor3 = props.accent or Sansik.Theme.Accent
        progressFill.BorderSizePixel = 0
        progressFill.ZIndex = 3
        progressFill.Parent = progressBg
        corner(progressFill, 1)

        tween(notif, 0.35, {Size = UDim2.new(1, 0, 0, 72), BackgroundTransparency = 0.1}):Play()
        tween(NotifTitle, 0.25, {TextTransparency = 0}):Play()
        tween(NotifContent, 0.25, {TextTransparency = 0.2}):Play()
        tween(closeBtn, 0.25, {ImageTransparency = 0.4}):Play()
        tween(progressFill, duration, {Size = UDim2.new(0, 0, 1, 0)}, Enum.EasingStyle.Linear):Play()

        closeBtn.MouseEnter:Connect(function()
            tween(closeBtn, 0.15, {ImageColor3 = Sansik.Theme.TextColor, ImageTransparency = 0, BackgroundTransparency = 0.85}):Play()
        end)
        closeBtn.MouseLeave:Connect(function()
            tween(closeBtn, 0.15, {ImageColor3 = Sansik.Theme.TextSecondary, ImageTransparency = 0.4, BackgroundTransparency = 1}):Play()
        end)

        local dismissed = false
        local function dismiss()
            if dismissed then return end
            dismissed = true
            tween(notif, 0.3, {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1}):Play()
            tween(NotifTitle, 0.2, {TextTransparency = 1}):Play()
            tween(NotifContent, 0.2, {TextTransparency = 1}):Play()
            tween(closeBtn, 0.2, {ImageTransparency = 1}):Play()
            tween(iconFrame, 0.2, {BackgroundTransparency = 1}):Play()
            tween(iconImg, 0.2, {ImageTransparency = 1}):Play()
            task.wait(0.35)
            notif:Destroy()
        end

        closeBtn.MouseButton1Click:Connect(dismiss)
        task.delay(duration, dismiss)
    end

    local function closeSearch()
        SearchOverlay.Visible = false
        SearchInput.Text = ""
        for _, page in ipairs(Content:GetChildren()) do
            if page:IsA("Frame") and page.Name:find("Page") then
                for _, el in ipairs(page:GetChildren()) do
                    if el:IsA("Frame") then el.Visible = true end
                end
            end
        end
    end

    SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(SearchInput.Text)
        for _, page in ipairs(Content:GetChildren()) do
            if page:IsA("Frame") and page.Name:find("Page") then
                for _, el in ipairs(page:GetChildren()) do
                    if el:IsA("Frame") and el.Name ~= "Section" then
                        if query == "" or string.find(string.lower(el.Name), query, 1, true) then
                            el.Visible = true
                        else
                            el.Visible = false
                        end
                    end
                end
            end
        end
    end)

    SearchBtn.MouseButton1Click:Connect(function()
        if SearchOverlay.Visible then
            closeSearch()
        else
            SearchOverlay.Visible = true
            SearchInput:CaptureFocus()
        end
    end)

    SearchInput.FocusLost:Connect(function()
        if SearchInput.Text == "" then closeSearch() end
    end)

    local function hideUI()
        if isHidden or isAnimating then return end
        isHidden = true
        isAnimating = true

        if openDropdownList then openDropdownList.Visible = false openDropdownList = nil end
        if openColorPicker and openColorPicker.close then openColorPicker.close() end
        closeSearch()

        local floatingAbs = FloatingBtn.AbsolutePosition
        local floatingSize = FloatingBtn.AbsoluteSize
        local mainAbs = Main.AbsolutePosition
        local mainSize = Main.AbsoluteSize
        local floatCenterX = floatingAbs.X + floatingSize.X / 2 - mainAbs.X
        local floatCenterY = floatingAbs.Y + floatingSize.Y / 2 - mainAbs.Y
        local anchorX = floatCenterX / mainSize.X
        local anchorY = floatCenterY / mainSize.Y

        FloatingBtn.Visible = true
        FloatingBtn.BackgroundTransparency = 1
        FloatingIcon.ImageTransparency = 1
        FloatingTitle.TextTransparency = 1
        FloatingSub.TextTransparency = 1
        FloatingScale.Scale = 0.5

        Main.AnchorPoint = Vector2.new(anchorX, anchorY)

        fadeRoot(Main, 1, 0.3)
        tween(MainScale, 0.3, {Scale = 0.1}):Play()

        task.wait(0.3)
        Main.Visible = false

        tween(FloatingScale, 0.3, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
        tween(FloatingBtn, 0.25, {BackgroundTransparency = 0}):Play()
        tween(FloatingIcon, 0.25, {ImageTransparency = 0}):Play()
        tween(FloatingTitle, 0.25, {TextTransparency = 0}):Play()
        tween(FloatingSub, 0.25, {TextTransparency = 0}):Play()

        task.wait(0.3)
        isAnimating = false
    end

    local function showUI()
        if not isHidden or isAnimating then return end
        isHidden = false
        isAnimating = true

        tween(FloatingScale, 0.2, {Scale = 0.5}):Play()
        tween(FloatingBtn, 0.2, {BackgroundTransparency = 1}):Play()
        tween(FloatingIcon, 0.2, {ImageTransparency = 1}):Play()
        tween(FloatingTitle, 0.2, {TextTransparency = 1}):Play()
        tween(FloatingSub, 0.2, {TextTransparency = 1}):Play()

        task.wait(0.2)
        FloatingBtn.Visible = false

        Main.AnchorPoint = Vector2.new(0.5, 0.5)
        Main.Position = UDim2.new(0.5, 0, 0.5, 0)
        MainScale.Scale = 0.1
        Main.Visible = true

        for _, desc in ipairs(Main:GetDescendants()) do
            if desc:IsA("Frame") or desc:IsA("TextButton") or desc:IsA("ImageButton") then
                local orig = desc:GetAttribute("_bgOrig")
                if orig ~= nil then desc.BackgroundTransparency = orig end
            end
            if desc:IsA("TextLabel") or desc:IsA("TextBox") then
                local orig = desc:GetAttribute("_txtOrig")
                if orig ~= nil then desc.TextTransparency = orig end
            end
            if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                local orig = desc:GetAttribute("_imgOrig")
                if orig ~= nil then desc.ImageTransparency = orig end
            end
            if desc:IsA("UIStroke") then
                local orig = desc:GetAttribute("_strokeOrig")
                if orig ~= nil then desc.Transparency = orig end
            end
            if desc:IsA("ScrollingFrame") then
                local orig = desc:GetAttribute("_scrollBarOrig")
                if orig ~= nil then desc.ScrollBarImageTransparency = orig end
            end
        end

        tween(MainScale, 0.4, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()

        task.wait(0.4)
        isAnimating = false
    end

    makeDraggable(Main, Topbar, nil, function() Sansik.ActiveWindow = Window end)
    makeDraggable(FloatingBtn, FloatingBtn, showUI, function() Sansik.ActiveWindow = Window end)

    FloatingBtn.MouseEnter:Connect(function()
        Sansik.ActiveWindow = Window
        if isHidden then
            tween(FloatingBtn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground}):Play()
        end
    end)
    FloatingBtn.MouseLeave:Connect(function()
        tween(FloatingBtn, 0.15, {BackgroundColor3 = Sansik.Theme.Background}):Play()
    end)

    MinimizeBtn.MouseButton1Click:Connect(function()
        Sansik.ActiveWindow = Window
        hideUI()
    end)
    CloseBtn.MouseButton1Click:Connect(function()
        Sansik.ActiveWindow = Window
        hideUI()
    end)

    function Window:Tab(props)
        props = props or {}
        local name = props.name or "Tab"
        local iconName = props.icon or nil

        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = name
        TabBtn.Size = UDim2.new(1, 0, 0, 34)
        TabBtn.BackgroundColor3 = Sansik.Theme.TabBackground
        TabBtn.BorderSizePixel = 0
        TabBtn.Text = ""
        TabBtn.BackgroundTransparency = 1
        TabBtn.AutoButtonColor = false
        TabBtn.Parent = TabList
        corner(TabBtn, 8)

        local TabIcon = Instance.new("ImageLabel")
        TabIcon.Size = UDim2.new(0, 18, 0, 18)
        TabIcon.Position = UDim2.new(0, 12, 0.5, -9)
        TabIcon.BackgroundTransparency = 1
        TabIcon.ImageColor3 = Sansik.Theme.TabTextColor
        TabIcon.Parent = TabBtn
        if iconName then
            local ico = getIcon(iconName)
            if ico then
                TabIcon.Image = ico.id
                if ico.rectOffset then TabIcon.ImageRectOffset = ico.rectOffset end
                if ico.rectSize then TabIcon.ImageRectSize = ico.rectSize end
            end
        end

        local BtnLabel = Instance.new("TextLabel")
        BtnLabel.Text = name
        BtnLabel.Font = Enum.Font.GothamMedium
        BtnLabel.TextSize = 13
        BtnLabel.TextColor3 = Sansik.Theme.TabTextColor
        BtnLabel.BackgroundTransparency = 1
        BtnLabel.TextXAlignment = Enum.TextXAlignment.Left
        BtnLabel.Position = UDim2.new(0, 40, 0, 0)
        BtnLabel.Size = UDim2.new(1, -48, 1, 0)
        BtnLabel.Parent = TabBtn

        local Page = Instance.new("Frame")
        Page.Size = UDim2.new(1, 0, 0, 0)
        Page.BackgroundTransparency = 1
        Page.AutomaticSize = Enum.AutomaticSize.Y
        Page.Visible = false
        Page.ClipsDescendants = false
        Page.Name = name .. "Page"
        Page.Parent = Content

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Padding = UDim.new(0, 6)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Parent = Page

        local function select()
            Sansik.ActiveWindow = Window
            if currentTab == Page then return end
            if openDropdownList then openDropdownList.Visible = false openDropdownList = nil end
            if openColorPicker and openColorPicker.close then openColorPicker.close() end

            if currentTab then
                currentTab.Visible = false
                local oldBtn = TabList:FindFirstChild(currentTab.Name:gsub("Page", ""))
                if oldBtn then
                    tween(oldBtn, 0.2, {BackgroundTransparency = 1}):Play()
                    local lbl = oldBtn:FindFirstChildOfClass("TextLabel")
                    local icn = oldBtn:FindFirstChild("Icon")
                    if lbl then tween(lbl, 0.2, {TextColor3 = Sansik.Theme.TabTextColor}):Play() end
                    if icn then tween(icn, 0.2, {ImageColor3 = Sansik.Theme.TabTextColor}):Play() end
                end
            end
            currentTab = Page
            Page.Visible = true
            tween(TabBtn, 0.2, {BackgroundTransparency = 0, BackgroundColor3 = Sansik.Theme.TabBackgroundSelected}):Play()
            tween(BtnLabel, 0.2, {TextColor3 = Sansik.Theme.TabTextSelected}):Play()
            tween(TabIcon, 0.2, {ImageColor3 = Sansik.Theme.TabTextSelected}):Play()
        end

        TabBtn.MouseButton1Click:Connect(select)
        TabBtn.MouseEnter:Connect(function()
            if currentTab ~= Page then
                tween(TabBtn, 0.15, {BackgroundTransparency = 0.6, BackgroundColor3 = Sansik.Theme.TabBackgroundHover}):Play()
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if currentTab ~= Page then tween(TabBtn, 0.15, {BackgroundTransparency = 1}):Play() end
        end)

        if not currentTab then select() end

        local Tab = {}
        local elementOrder = 0

        local function nextOrder()
            elementOrder = elementOrder + 1
            return elementOrder
        end

        local function baseElement(height)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, height)
            frame.BackgroundColor3 = Sansik.Theme.ElementBackground
            frame.BorderSizePixel = 0
            frame.LayoutOrder = nextOrder()
            frame.Parent = Page
            corner(frame, 10)
            stroke(frame, Sansik.Theme.ElementStroke, 1, 0.5)
            return frame
        end

        function Tab:Button(props)
            local btn = baseElement(44)
            btn.Name = props.name or "Button"
            local label = Instance.new("TextLabel")
            label.Text = props.name or "Button"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 0)
            label.Size = UDim2.new(1, -28, 1, 0)
            label.Parent = btn

            btn.MouseEnter:Connect(function() tween(btn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover}):Play() end)
            btn.MouseLeave:Connect(function() tween(btn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground}):Play() end)

            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.AutoButtonColor = false
            clickable.Parent = btn
            corner(clickable, 10)
            clickable.MouseButton1Click:Connect(function()
                if props.callback then pcall(props.callback) end
            end)

            return { Set = function(self, newText) label.Text = newText end }
        end

        function Tab:Toggle(props)
            local toggle = baseElement(46)
            toggle.Name = props.name or "Toggle"
            local label = Instance.new("TextLabel")
            label.Text = props.name or "Toggle"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 6)
            label.Size = UDim2.new(1, -80, 0, 16)
            label.Parent = toggle

            local desc = Instance.new("TextLabel")
            desc.Text = props.description or ""
            desc.Font = Enum.Font.Gotham
            desc.TextSize = 11
            desc.TextColor3 = Sansik.Theme.TextSecondary
            desc.BackgroundTransparency = 1
            desc.TextXAlignment = Enum.TextXAlignment.Left
            desc.Position = UDim2.new(0, 14, 0, 24)
            desc.Size = UDim2.new(1, -80, 0, 14)
            desc.Parent = toggle

            local switchBg = Instance.new("Frame")
            switchBg.Size = UDim2.new(0, 48, 0, 26)
            switchBg.Position = UDim2.new(1, -62, 0.5, -13)
            switchBg.BackgroundTransparency = 1
            switchBg.BorderSizePixel = 0
            switchBg.Parent = toggle
            corner(switchBg, 13)
            local switchStroke = stroke(switchBg, Sansik.Theme.ToggleDisabledStroke, 1.5, 0)

            local indicator = Instance.new("Frame")
            indicator.Size = UDim2.new(0, 20, 0, 20)
            indicator.Position = UDim2.new(0, 3, 0.5, -10)
            indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            indicator.BorderSizePixel = 0
            indicator.Parent = switchBg
            corner(indicator, 10)

            local state = props.value or false
            if props.flag and Sansik.Flags[props.flag] ~= nil then state = Sansik.Flags[props.flag] end

            local function updateSwitch(animated)
                if state then
                    tween(switchStroke, animated and 0.2 or 0, {Color = Sansik.Theme.ToggleEnabledStroke, Transparency = 0.2}):Play()
                    tween(indicator, animated and 0.2 or 0, {BackgroundColor3 = Sansik.Theme.ToggleEnabled, Position = UDim2.new(1, -23, 0.5, -10)}):Play()
                else
                    tween(switchStroke, animated and 0.2 or 0, {Color = Sansik.Theme.ToggleDisabledStroke, Transparency = 0}):Play()
                    tween(indicator, animated and 0.2 or 0, {BackgroundColor3 = Color3.fromRGB(255, 255, 255), Position = UDim2.new(0, 3, 0.5, -10)}):Play()
                end
            end
            updateSwitch(false)

            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.AutoButtonColor = false
            clickable.Parent = toggle
            corner(clickable, 10)
            clickable.MouseEnter:Connect(function() tween(toggle, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover}):Play() end)
            clickable.MouseLeave:Connect(function() tween(toggle, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground}):Play() end)
            clickable.MouseButton1Click:Connect(function()
                state = not state
                updateSwitch(true)
                if props.flag then Sansik.Flags[props.flag] = state end
                if props.callback then pcall(props.callback, state) end
            end)

            if props.flag then Sansik.Flags[props.flag] = state end
            return {
                value = state,
                Set = function(self, v, silent)
                    state = v
                    updateSwitch(true)
                    if props.flag then Sansik.Flags[props.flag] = state end
                    if not silent and props.callback then pcall(props.callback, state) end
                end
            }
        end

        function Tab:Slider(props)
            local slider = baseElement(56)
            slider.Name = props.name or "Slider"
            local label = Instance.new("TextLabel")
            label.Text = props.name or "Slider"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 8)
            label.Size = UDim2.new(0.5, 0, 0, 16)
            label.Parent = slider

            local valueLabel = Instance.new("TextLabel")
            valueLabel.Font = Enum.Font.Gotham
            valueLabel.TextSize = 11
            valueLabel.TextColor3 = Sansik.Theme.TextSecondary
            valueLabel.BackgroundTransparency = 1
            valueLabel.TextXAlignment = Enum.TextXAlignment.Left
            valueLabel.Position = UDim2.new(0, 14, 0, 28)
            valueLabel.Size = UDim2.new(0.5, 0, 0, 14)
            valueLabel.Parent = slider

            local track = Instance.new("Frame")
            track.Size = UDim2.new(0, 240, 0, 8)
            track.Position = UDim2.new(1, -254, 0.5, -4)
            track.BackgroundColor3 = Sansik.Theme.SliderBackground
            track.BorderSizePixel = 0
            track.Parent = slider
            corner(track, 4)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BackgroundColor3 = Sansik.Theme.SliderProgress
            fill.BorderSizePixel = 0
            fill.Parent = track
            corner(fill, 4)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.new(0, 26, 0, 16)
            knob.Position = UDim2.new(0, 0, 0.5, -8)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.BorderSizePixel = 0
            knob.ZIndex = 2
            knob.Parent = track
            corner(knob, 8)

            local min = props.range[1]
            local max = props.range[2]
            local increment = props.increment or 1
            local currentValue = props.value or min
            if props.flag and Sansik.Flags[props.flag] ~= nil then currentValue = Sansik.Flags[props.flag] end

            local function setValue(v, animated, silent)
                currentValue = math.clamp(v, min, max)
                local percent = (currentValue - min) / (max - min)
                tween(fill, animated and 0.08 or 0, {Size = UDim2.new(percent, 0, 1, 0)}):Play()
                tween(knob, animated and 0.08 or 0, {Position = UDim2.new(percent, -13, 0.5, -8)}):Play()
                valueLabel.Text = tostring(currentValue) .. (props.suffix and (" " .. props.suffix) or "")
                if props.flag then Sansik.Flags[props.flag] = currentValue end
                if not silent and props.callback then pcall(props.callback, currentValue) end
            end
            setValue(currentValue, false, true)

            local dragging = false
            local trackBtn = Instance.new("TextButton")
            trackBtn.Size = UDim2.new(1, 0, 1, 0)
            trackBtn.BackgroundTransparency = 1
            trackBtn.Text = ""
            trackBtn.AutoButtonColor = false
            trackBtn.Parent = track
            corner(trackBtn, 4)

            local function updateFromInput(input)
                local relativeX = input.Position.X - track.AbsolutePosition.X
                local percent = math.clamp(relativeX / track.AbsoluteSize.X, 0, 1)
                local raw = min + percent * (max - min)
                raw = math.floor(raw / increment + 0.5) * increment
                setValue(raw, true, false)
            end

            trackBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateFromInput(input)
                end
            end)
            Services.UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateFromInput(input)
                end
            end)
            Services.UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            if props.flag then Sansik.Flags[props.flag] = currentValue end
            return {
                value = currentValue,
                Set = function(self, v, silent) setValue(v, true, silent) end
            }
        end

        function Tab:Dropdown(props)
            local dropdown = baseElement(46)
            dropdown.Name = props.name or "Dropdown"
            dropdown.ClipsDescendants = false
            dropdown.ZIndex = 1

            local label = Instance.new("TextLabel")
            label.Text = props.name or "Dropdown"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 0)
            label.Size = UDim2.new(0.5, 0, 1, 0)
            label.ZIndex = 2
            label.Parent = dropdown

            local selectedLabel = Instance.new("TextLabel")
            selectedLabel.Text = props.value or "None"
            selectedLabel.Font = Enum.Font.Gotham
            selectedLabel.TextSize = 12
            selectedLabel.TextColor3 = Sansik.Theme.TextSecondary
            selectedLabel.BackgroundTransparency = 1
            selectedLabel.TextXAlignment = Enum.TextXAlignment.Right
            selectedLabel.Position = UDim2.new(0.5, 0, 0, 0)
            selectedLabel.Size = UDim2.new(0.5, -40, 1, 0)
            selectedLabel.ZIndex = 2
            selectedLabel.Parent = dropdown

            local arrow = Instance.new("ImageLabel")
            arrow.Size = UDim2.new(0, 14, 0, 14)
            arrow.Position = UDim2.new(1, -24, 0.5, -7)
            arrow.BackgroundTransparency = 1
            arrow.ImageColor3 = Sansik.Theme.TextSecondary
            arrow.ZIndex = 2
            arrow.Parent = dropdown
            local arrowIco = getIcon("chevron-down")
            if arrowIco then
                arrow.Image = arrowIco.id
                if arrowIco.rectOffset then arrow.ImageRectOffset = arrowIco.rectOffset end
                if arrowIco.rectSize then arrow.ImageRectSize = arrowIco.rectSize end
            end

            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.AutoButtonColor = false
            clickable.ZIndex = 3
            clickable.Parent = dropdown
            corner(clickable, 10)
            clickable.MouseEnter:Connect(function() tween(dropdown, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover}):Play() end)
            clickable.MouseLeave:Connect(function()
                if not dropdown:GetAttribute("Open") then
                    tween(dropdown, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground}):Play()
                end
            end)

            local list = Instance.new("Frame")
            list.Size = UDim2.new(0, 0, 0, 0)
            list.BackgroundColor3 = Sansik.Theme.DropdownBackground
            list.BorderSizePixel = 0
            list.Visible = false
            list.ClipsDescendants = true
            list.ZIndex = 501
            list.Parent = DropdownLayer
            corner(list, 10)
            stroke(list, Sansik.Theme.ElementStroke, 1, 0.5)

            local searchContainer = Instance.new("Frame")
            searchContainer.Size = UDim2.new(1, -16, 0, 32)
            searchContainer.Position = UDim2.new(0, 8, 0, 8)
            searchContainer.BackgroundColor3 = Sansik.Theme.DropdownOption
            searchContainer.BorderSizePixel = 0
            searchContainer.ZIndex = 502
            searchContainer.Parent = list
            corner(searchContainer, 6)

            local searchIcon = Instance.new("ImageLabel")
            searchIcon.Size = UDim2.new(0, 14, 0, 14)
            searchIcon.Position = UDim2.new(0, 10, 0.5, -7)
            searchIcon.BackgroundTransparency = 1
            searchIcon.ImageColor3 = Sansik.Theme.TextSecondary
            searchIcon.ZIndex = 503
            searchIcon.Parent = searchContainer
            local searchIco2 = getIcon("search")
            if searchIco2 then
                searchIcon.Image = searchIco2.id
                if searchIco2.rectOffset then searchIcon.ImageRectOffset = searchIco2.rectOffset end
                if searchIco2.rectSize then searchIcon.ImageRectSize = searchIco2.rectSize end
            end

            local searchBox = Instance.new("TextBox")
            searchBox.Size = UDim2.new(1, -36, 1, 0)
            searchBox.Position = UDim2.new(0, 32, 0, 0)
            searchBox.BackgroundTransparency = 1
            searchBox.Text = ""
            searchBox.PlaceholderText = "Search..."
            searchBox.Font = Enum.Font.Gotham
            searchBox.TextSize = 12
            searchBox.TextColor3 = Sansik.Theme.TextColor
            searchBox.PlaceholderColor3 = Sansik.Theme.TextSecondary
            searchBox.TextXAlignment = Enum.TextXAlignment.Left
            searchBox.ClearTextOnFocus = false
            searchBox.ZIndex = 503
            searchBox.Parent = searchContainer

            local optionsScroll = Instance.new("ScrollingFrame")
            optionsScroll.Size = UDim2.new(1, -16, 1, -48)
            optionsScroll.Position = UDim2.new(0, 8, 0, 48)
            optionsScroll.BackgroundTransparency = 1
            optionsScroll.BorderSizePixel = 0
            optionsScroll.ScrollBarThickness = 3
            optionsScroll.ScrollBarImageColor3 = Sansik.Theme.ElementStroke
            optionsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
            optionsScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
            optionsScroll.ZIndex = 502
            optionsScroll.Parent = list

            local optionsLayout = Instance.new("UIListLayout")
            optionsLayout.Padding = UDim.new(0, 4)
            optionsLayout.SortOrder = Enum.SortOrder.LayoutOrder
            optionsLayout.Parent = optionsScroll

            local currentValue = props.value or nil
            if props.flag and Sansik.Flags[props.flag] ~= nil then currentValue = Sansik.Flags[props.flag] end
            local optionButtons = {}

            local function updateSelected() selectedLabel.Text = currentValue or "None" end
            updateSelected()

            local function computeListHeight()
                local optionsCount = #optionButtons
                local neededH = 48 + optionsCount * 42 + 16
                return math.min(neededH, 200)
            end

            local function closeList()
                dropdown:SetAttribute("Open", false)
                arrow.Rotation = 0
                tween(list, 0.2, {Size = UDim2.new(0, dropdown.AbsoluteSize.X, 0, 0), BackgroundTransparency = 1}):Play()
                task.wait(0.2)
                list.Visible = false
                if openDropdownList == list then openDropdownList = nil end
                tween(dropdown, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground}):Play()
            end

            local function updateListPosition()
                local dropdownAbs = dropdown.AbsolutePosition
                local mainAbs = Main.AbsolutePosition
                local mainSize = Main.AbsoluteSize
                local padding = 10
                local listH = computeListHeight()

                local relX = dropdownAbs.X - mainAbs.X
                local relY = dropdownAbs.Y - mainAbs.Y + dropdown.AbsoluteSize.Y + 4

                if relX + dropdown.AbsoluteSize.X > mainSize.X - padding then
                    relX = mainSize.X - dropdown.AbsoluteSize.X - padding
                end
                if relX < padding then relX = padding end

                -- Открываем снизу, только если не влезает — сверху
                if relY + listH > mainSize.Y - padding then
                    local topY = dropdownAbs.Y - mainAbs.Y - listH - 4
                    if topY >= padding then
                        relY = topY
                    else
                        relY = mainSize.Y - listH - padding
                    end
                end
                if relY < padding then relY = padding end

                list.Position = UDim2.new(0, relX, 0, relY)
                list.Size = UDim2.new(0, dropdown.AbsoluteSize.X, 0, 0)
            end

            local function createOption(optionName)
                local optionBtn = Instance.new("TextButton")
                optionBtn.Name = optionName
                optionBtn.Size = UDim2.new(1, 0, 0, 38)
                optionBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                optionBtn.BorderSizePixel = 0
                optionBtn.Text = ""
                optionBtn.AutoButtonColor = false
                optionBtn.ZIndex = 503
                optionBtn.Parent = optionsScroll
                corner(optionBtn, 6)

                local optIcon = Instance.new("ImageLabel")
                optIcon.Size = UDim2.new(0, 16, 0, 16)
                optIcon.Position = UDim2.new(0, 12, 0.5, -8)
                optIcon.BackgroundTransparency = 1
                optIcon.ImageColor3 = Sansik.Theme.TextSecondary
                optIcon.ZIndex = 504
                optIcon.Parent = optionBtn

                local optLabel = Instance.new("TextLabel")
                optLabel.Text = optionName
                optLabel.Font = Enum.Font.Gotham
                optLabel.TextSize = 12
                optLabel.TextColor3 = Sansik.Theme.TextColor
                optLabel.BackgroundTransparency = 1
                optLabel.TextXAlignment = Enum.TextXAlignment.Left
                optLabel.Position = UDim2.new(0, 38, 0, 0)
                optLabel.Size = UDim2.new(1, -50, 1, 0)
                optLabel.ZIndex = 504
                optLabel.Parent = optionBtn

                local function setState(isSelected)
                    if isSelected then
                        local ci = getIcon("check")
                        if ci then
                            optIcon.Image = ci.id
                            if ci.rectOffset then optIcon.ImageRectOffset = ci.rectOffset end
                            if ci.rectSize then optIcon.ImageRectSize = ci.rectSize end
                        end
                        optIcon.ImageColor3 = Sansik.Theme.TextColor
                        optionBtn.BackgroundColor3 = Sansik.Theme.DropdownOptionHover
                    else
                        local si = getIcon("square")
                        if si then
                            optIcon.Image = si.id
                            if si.rectOffset then optIcon.ImageRectOffset = si.rectOffset end
                            if si.rectSize then optIcon.ImageRectSize = si.rectSize end
                        end
                        optIcon.ImageColor3 = Sansik.Theme.TextSecondary
                        optionBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                    end
                end

                setState(currentValue == optionName)

                optionBtn.MouseEnter:Connect(function()
                    if currentValue ~= optionName then tween(optionBtn, 0.12, {BackgroundColor3 = Sansik.Theme.DropdownOptionHover}):Play() end
                end)
                optionBtn.MouseLeave:Connect(function()
                    if currentValue ~= optionName then tween(optionBtn, 0.12, {BackgroundColor3 = Sansik.Theme.DropdownOption}):Play() end
                end)

                optionBtn.MouseButton1Click:Connect(function()
                    currentValue = optionName
                    updateSelected()
                    for _, optBtn in ipairs(optionButtons) do
                        local ico = optBtn:FindFirstChildOfClass("ImageLabel")
                        if ico then
                            local isSel = (optBtn.Name == currentValue)
                            if isSel then
                                local ci = getIcon("check")
                                if ci then
                                    ico.Image = ci.id
                                    if ci.rectOffset then ico.ImageRectOffset = ci.rectOffset end
                                    if ci.rectSize then ico.ImageRectSize = ci.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextColor
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOptionHover
                            else
                                local si = getIcon("square")
                                if si then
                                    ico.Image = si.id
                                    if si.rectOffset then ico.ImageRectOffset = si.rectOffset end
                                    if si.rectSize then ico.ImageRectSize = si.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextSecondary
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                            end
                        end
                    end
                    if props.flag then Sansik.Flags[props.flag] = currentValue end
                    if props.callback then pcall(props.callback, currentValue) end
                    closeList()
                end)

                return optionBtn
            end

            for _, optionName in ipairs(props.options or {}) do
                table.insert(optionButtons, createOption(optionName))
            end

            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local query = string.lower(searchBox.Text)
                for _, optBtn in ipairs(optionButtons) do
                    if string.find(string.lower(optBtn.Name), query, 1, true) then
                        optBtn.Visible = true
                    else
                        optBtn.Visible = false
                    end
                end
            end)

            clickable.MouseButton1Click:Connect(function()
                Sansik.ActiveWindow = Window
                local isOpen = dropdown:GetAttribute("Open") or false
                if isOpen then
                    closeList()
                else
                    if openDropdownList and openDropdownList ~= list then
                        openDropdownList.Visible = false
                        openDropdownList.Size = UDim2.new(0, 0, 0, 0)
                    end
                    if openColorPicker and openColorPicker.close then openColorPicker.close() end
                    dropdown:SetAttribute("Open", true)
                    arrow.Rotation = 180
                    updateListPosition()
                    list.Visible = true
                    list.BackgroundTransparency = 1
                    openDropdownList = list
                    local finalH = computeListHeight()
                    tween(list, 0.25, {Size = UDim2.new(0, dropdown.AbsoluteSize.X, 0, finalH), BackgroundTransparency = 0}):Play()
                end
            end)

            Page:GetPropertyChangedSignal("Visible"):Connect(function()
                if not Page.Visible and list.Visible then list.Visible = false end
            end)

            if props.flag then Sansik.Flags[props.flag] = currentValue end
            return {
                value = currentValue,
                Set = function(self, v, silent)
                    currentValue = v
                    updateSelected()
                    for _, optBtn in ipairs(optionButtons) do
                        local ico = optBtn:FindFirstChildOfClass("ImageLabel")
                        if ico then
                            local isSel = (optBtn.Name == currentValue)
                            if isSel then
                                local ci = getIcon("check")
                                if ci then
                                    ico.Image = ci.id
                                    if ci.rectOffset then ico.ImageRectOffset = ci.rectOffset end
                                    if ci.rectSize then ico.ImageRectSize = ci.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextColor
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOptionHover
                            else
                                local si = getIcon("square")
                                if si then
                                    ico.Image = si.id
                                    if si.rectOffset then ico.ImageRectOffset = si.rectOffset end
                                    if si.rectSize then ico.ImageRectSize = si.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextSecondary
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                            end
                        end
                    end
                    if props.flag then Sansik.Flags[props.flag] = currentValue end
                    if not silent and props.callback then pcall(props.callback, currentValue) end
                end
            }
        end

        function Tab:MultiDropdown(props)
            local dropdown = baseElement(46)
            dropdown.Name = props.name or "MultiDropdown"
            dropdown.ClipsDescendants = false
            dropdown.ZIndex = 1

            local label = Instance.new("TextLabel")
