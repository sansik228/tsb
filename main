-- Sansik UI Library v2.0
-- Sidebar layout inspired by Rayfield Gen2

local Sansik = {}
Sansik.Flags = {}
Sansik.Theme = {
    TextColor = Color3.fromRGB(240, 240, 245),
    TextSecondary = Color3.fromRGB(140, 140, 150),
    Background = Color3.fromRGB(18, 18, 22),
    Sidebar = Color3.fromRGB(22, 22, 26),
    Topbar = Color3.fromRGB(18, 18, 22),
    Shadow = Color3.fromRGB(0, 0, 0),
    TabBackground = Color3.fromRGB(28, 28, 34),
    TabBackgroundHover = Color3.fromRGB(34, 34, 42),
    TabBackgroundSelected = Color3.fromRGB(40, 40, 48),
    TabTextColor = Color3.fromRGB(180, 180, 190),
    TabTextSelected = Color3.fromRGB(255, 255, 255),
    ElementBackground = Color3.fromRGB(28, 28, 34),
    ElementBackgroundHover = Color3.fromRGB(34, 34, 42),
    ElementStroke = Color3.fromRGB(45, 45, 55),
    SliderBackground = Color3.fromRGB(45, 45, 55),
    SliderProgress = Color3.fromRGB(0, 200, 130),
    ToggleEnabled = Color3.fromRGB(0, 200, 130),
    ToggleDisabled = Color3.fromRGB(60, 60, 70),
    NotificationBackground = Color3.fromRGB(22, 22, 26),
    InputBackground = Color3.fromRGB(28, 28, 34),
    InputStroke = Color3.fromRGB(55, 55, 65),
    PlaceholderColor = Color3.fromRGB(120, 120, 130),
    Accent = Color3.fromRGB(0, 200, 130),
}

local Services = {
    UserInputService = game:GetService("UserInputService"),
    TweenService = game:GetService("TweenService"),
    RunService = game:GetService("RunService"),
    Players = game:GetService("Players"),
    CoreGui = game:GetService("CoreGui"),
    HttpService = game:GetService("HttpService"),
}

local Player = Services.Players.LocalPlayer

-- Иконки Lucide
local Icons = {}
pcall(function()
    Icons = loadstring(game:HttpGet("https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/refs/heads/main/icons.lua"))()
end)

local function getIcon(name)
    if not Icons or not name then return nil end
    local icon = Icons['48px'][string.lower(name)]
    if not icon then return nil end
    return {
        id = "rbxassetid://" .. icon[1],
        rectOffset = Vector2.new(icon[3][1], icon[3][2]),
        rectSize = Vector2.new(icon[2][1], icon[2][2]),
    }
end

local function tween(obj, time, props, style, dir)
    Services.TweenService:Create(
        obj,
        TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Exponential, dir or Enum.EasingDirection.Out),
        props
    ):Play()
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Sansik.Theme.ElementStroke
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = parent
    return s
end

local function makeDraggable(frame, dragFrame)
    local dragging, dragStart, startPos

    dragFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

-- ============ БИБЛИОТЕКА ============

function Sansik:Window(props)
    props = props or {}

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "SansikUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.DisplayOrder = 100

    if gethui then
        ScreenGui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(ScreenGui)
        ScreenGui.Parent = Services.CoreGui
    else
        ScreenGui.Parent = Services.CoreGui
    end

    -- ============ MAIN ============
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = UDim2.new(0, 600, 0, 400)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.BackgroundColor3 = Sansik.Theme.Background
    Main.BorderSizePixel = 0
    Main.Active = true
    Main.ClipsDescendants = true
    Main.Parent = ScreenGui
    corner(Main, 12)
    stroke(Main, Sansik.Theme.ElementStroke, 1, 0.6)

    -- Тень
    local Shadow = Instance.new("ImageLabel")
    Shadow.Name = "Shadow"
    Shadow.Size = UDim2.new(1, 40, 1, 40)
    Shadow.Position = UDim2.new(0, -20, 0, -20)
    Shadow.BackgroundTransparency = 1
    Shadow.Image = "rbxassetid://5587865193"
    Shadow.ImageColor3 = Sansik.Theme.Shadow
    Shadow.ImageTransparency = 0.5
    Shadow.ScaleType = Enum.ScaleType.Slice
    Shadow.SliceCenter = Rect.new(10, 10, 490, 490)
    Shadow.ZIndex = -1
    Shadow.Parent = Main

    -- ============ TOPBAR ============
    local Topbar = Instance.new("Frame")
    Topbar.Name = "Topbar"
    Topbar.Size = UDim2.new(1, 0, 0, 56)
    Topbar.BackgroundColor3 = Sansik.Theme.Topbar
    Topbar.BorderSizePixel = 0
    Topbar.Active = true
    Topbar.Parent = Main

    -- Заголовок
    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.Text = props.title or "Sansik Hub"
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 17
    Title.TextColor3 = Sansik.Theme.TextColor
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Position = UDim2.new(0, 20, 0, 10)
    Title.Size = UDim2.new(0.5, 0, 0, 20)
    Title.Parent = Topbar

    -- Подпись
    local Subtitle = Instance.new("TextLabel")
    Subtitle.Name = "Subtitle"
    Subtitle.Text = props.subtitle or "Universal | Real 97% UNC"
    Subtitle.Font = Enum.Font.Gotham
    Subtitle.TextSize = 11
    Subtitle.TextColor3 = Sansik.Theme.TextSecondary
    Subtitle.BackgroundTransparency = 1
    Subtitle.TextXAlignment = Enum.TextXAlignment.Left
    Subtitle.Position = UDim2.new(0, 20, 0, 32)
    Subtitle.Size = UDim2.new(0.5, 0, 0, 14)
    Subtitle.Parent = Topbar

    -- Кнопки действий
    local function topbarButton(name, xOffset, iconName)
        local btn = Instance.new("ImageButton")
        btn.Name = name
        btn.Size = UDim2.new(0, 26, 0, 26)
        btn.Position = UDim2.new(1, xOffset, 0.5, -13)
        btn.BackgroundTransparency = 1
        btn.Image = ""
        btn.Parent = Topbar
        corner(btn, 6)

        if iconName and Icons then
            local ico = getIcon(iconName)
            if ico then
                btn.Image = ico.id
                btn.ImageRectOffset = ico.rectOffset
                btn.ImageRectSize = ico.rectSize
                btn.ImageColor3 = Sansik.Theme.TextSecondary
            end
        end

        btn.MouseEnter:Connect(function()
            tween(btn, 0.15, {BackgroundTransparency = 0.85, ImageColor3 = Sansik.Theme.TextColor})
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, 0.15, {BackgroundTransparency = 1, ImageColor3 = Sansik.Theme.TextSecondary})
        end)

        return btn
    end

    local SearchBtn = topbarButton("Search", -140, "search")
    local SettingsBtn = topbarButton("Settings", -110, "settings")
    local MinimizeBtn = topbarButton("Minimize", -80, "minus")
    local CloseBtn = topbarButton("Close", -50, "x")

    -- Разделитель под топбаром
    local TopbarDivider = Instance.new("Frame")
    TopbarDivider.Size = UDim2.new(1, 0, 0, 1)
    TopbarDivider.Position = UDim2.new(0, 0, 1, -1)
    TopbarDivider.BackgroundColor3 = Sansik.Theme.ElementStroke
    TopbarDivider.BorderSizePixel = 0
    TopbarDivider.BackgroundTransparency = 0.5
    TopbarDivider.Parent = Topbar

    -- ============ SIDEBAR ============
    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Size = UDim2.new(0, 180, 1, -56)
    Sidebar.Position = UDim2.new(0, 0, 0, 56)
    Sidebar.BackgroundColor3 = Sansik.Theme.Sidebar
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main

    -- Разделитель сайдбара
    local SidebarDivider = Instance.new("Frame")
    SidebarDivider.Size = UDim2.new(0, 1, 1, 0)
    SidebarDivider.Position = UDim2.new(1, -1, 0, 0)
    SidebarDivider.BackgroundColor3 = Sansik.Theme.ElementStroke
    SidebarDivider.BorderSizePixel = 0
    SidebarDivider.BackgroundTransparency = 0.5
    SidebarDivider.Parent = Sidebar

    -- Список вкладок
    local TabList = Instance.new("Frame")
    TabList.Name = "TabList"
    TabList.Size = UDim2.new(1, -16, 1, -80)
    TabList.Position = UDim2.new(0, 8, 0, 8)
    TabList.BackgroundTransparency = 1
    TabList.Parent = Sidebar

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.Padding = UDim.new(0, 4)
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Parent = TabList

    -- Профиль игрока (внизу сайдбара)
    local Profile = Instance.new("Frame")
    Profile.Name = "Profile"
    Profile.Size = UDim2.new(1, -16, 0, 56)
    Profile.Position = UDim2.new(0, 8, 1, -64)
    Profile.BackgroundColor3 = Sansik.Theme.TabBackground
    Profile.BorderSizePixel = 0
    Profile.Parent = Sidebar
    corner(Profile, 8)

    local Avatar = Instance.new("ImageLabel")
    Avatar.Name = "Avatar"
    Avatar.Size = UDim2.new(0, 36, 0, 36)
    Avatar.Position = UDim2.new(0, 10, 0.5, -18)
    Avatar.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    Avatar.BorderSizePixel = 0
    Avatar.Image = ""
    Avatar.Parent = Profile
    corner(Avatar, 18)

    -- Загружаем аватар
    task.spawn(function()
        local ok, thumb = pcall(function()
            return Services.Players:GetUserThumbnailAsync(
                Player.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
        end)
        if ok and thumb then
            Avatar.Image = thumb
        end
    end)

    local PlayerName = Instance.new("TextLabel")
    PlayerName.Name = "PlayerName"
    PlayerName.Text = Player.DisplayName or Player.Name
    PlayerName.Font = Enum.Font.GothamMedium
    PlayerName.TextSize = 12
    PlayerName.TextColor3 = Sansik.Theme.TextColor
    PlayerName.BackgroundTransparency = 1
    PlayerName.TextXAlignment = Enum.TextXAlignment.Left
    PlayerName.TextTruncate = Enum.TextTruncate.AtEnd
    PlayerName.Position = UDim2.new(0, 54, 0.5, -8)
    PlayerName.Size = UDim2.new(1, -64, 0, 16)
    PlayerName.Parent = Profile

    -- ============ CONTENT ============
    local Content = Instance.new("ScrollingFrame")
    Content.Name = "Content"
    Content.Size = UDim2.new(1, -196, 1, -72)
    Content.Position = UDim2.new(0, 188, 0, 64)
    Content.BackgroundTransparency = 1
    Content.BorderSizePixel = 0
    Content.ScrollBarThickness = 3
    Content.ScrollBarImageColor3 = Sansik.Theme.ElementStroke
    Content.CanvasSize = UDim2.new(0, 0, 0, 0)
    Content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Content.Parent = Main

    makeDraggable(Main, Topbar)

    -- ============ NOTIFICATIONS ============
    local NotifFrame = Instance.new("Frame")
    NotifFrame.Name = "Notifications"
    NotifFrame.Size = UDim2.new(0, 280, 1, -40)
    NotifFrame.Position = UDim2.new(1, -300, 0, 20)
    NotifFrame.BackgroundTransparency = 1
    NotifFrame.Parent = ScreenGui

    local NotifLayout = Instance.new("UIListLayout")
    NotifLayout.Padding = UDim.new(0, 8)
    NotifLayout.SortOrder = Enum.SortOrder.LayoutOrder
    NotifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    NotifLayout.Parent = NotifFrame

    -- ============ WINDOW OBJECT ============
    local Window = {}
    local currentTab = nil

    function Window:Notify(props)
        props = props or {}

        local notif = Instance.new("Frame")
        notif.Size = UDim2.new(1, 0, 0, 0)
        notif.BackgroundColor3 = Sansik.Theme.NotificationBackground
        notif.BorderSizePixel = 0
        notif.Parent = NotifFrame
        corner(notif, 8)
        stroke(notif, Sansik.Theme.ElementStroke, 1, 0.5)
        notif.BackgroundTransparency = 1
        notif.ClipsDescendants = true

        local NotifTitle = Instance.new("TextLabel")
        NotifTitle.Text = props.title or "Notification"
        NotifTitle.Font = Enum.Font.GothamMedium
        NotifTitle.TextSize = 13
        NotifTitle.TextColor3 = Sansik.Theme.TextColor
        NotifTitle.BackgroundTransparency = 1
        NotifTitle.TextXAlignment = Enum.TextXAlignment.Left
        NotifTitle.Position = UDim2.new(0, 12, 0, 8)
        NotifTitle.Size = UDim2.new(1, -24, 0, 16)
        NotifTitle.TextTransparency = 1
        NotifTitle.Parent = notif

        local NotifContent = Instance.new("TextLabel")
        NotifContent.Text = props.content or ""
        NotifContent.Font = Enum.Font.Gotham
        NotifContent.TextSize = 11
        NotifContent.TextColor3 = Sansik.Theme.TextSecondary
        NotifContent.BackgroundTransparency = 1
        NotifContent.TextXAlignment = Enum.TextXAlignment.Left
        NotifContent.TextWrapped = true
        NotifContent.Position = UDim2.new(0, 12, 0, 26)
        NotifContent.Size = UDim2.new(1, -24, 0, 30)
        NotifContent.TextTransparency = 1
        NotifContent.Parent = notif

        tween(notif, 0.3, {Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 0.1})
        tween(NotifTitle, 0.25, {TextTransparency = 0})
        tween(NotifContent, 0.25, {TextTransparency = 0.2})

        task.delay(props.duration or 4, function()
            tween(notif, 0.3, {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1})
            tween(NotifTitle, 0.2, {TextTransparency = 1})
            tween(NotifContent, 0.2, {TextTransparency = 1})
            task.wait(0.35)
            notif:Destroy()
        end)
    end

    -- ============ TAB ============
    function Window:Tab(props)
        props = props or {}
        local name = props.name or "Tab"
        local iconName = props.icon or nil

        -- Кнопка вкладки в сайдбаре
        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = name
        TabBtn.Size = UDim2.new(1, 0, 0, 34)
        TabBtn.BackgroundColor3 = Sansik.Theme.TabBackground
        TabBtn.BorderSizePixel = 0
        TabBtn.Text = ""
        TabBtn.BackgroundTransparency = 1
        TabBtn.Parent = TabList
        corner(TabBtn, 8)

        -- Иконка
        local TabIcon = Instance.new("ImageLabel")
        TabIcon.Name = "Icon"
        TabIcon.Size = UDim2.new(0, 18, 0, 18)
        TabIcon.Position = UDim2.new(0, 12, 0.5, -9)
        TabIcon.BackgroundTransparency = 1
        TabIcon.ImageColor3 = Sansik.Theme.TabTextColor
        TabIcon.Parent = TabBtn

        if iconName and Icons then
            local ico = getIcon(iconName)
            if ico then
                TabIcon.Image = ico.id
                TabIcon.ImageRectOffset = ico.rectOffset
                TabIcon.ImageRectSize = ico.rectSize
            end
        end

        -- Текст
        local BtnLabel = Instance.new("TextLabel")
        BtnLabel.Text = name
        BtnLabel.Font = Enum.Font.GothamMedium
        BtnLabel.TextSize = 13
        BtnLabel.TextColor3 = Sansik.Theme.TabTextColor
        BtnLabel.BackgroundTransparency = 1
        BtnLabel.TextXAlignment = Enum.TextXAlignment.Left
        BtnLabel.Position = UDim2.new(0, 40, 0, 0)
        BtnLabel.Size = UDim2.new(1, -48, 1, 0)
        BtnLabel.Parent = TabBtn

        -- Страница контента
        local Page = Instance.new("Frame")
        Page.Name = name .. "Page"
        Page.Size = UDim2.new(1, 0, 0, 0)
        Page.BackgroundTransparency = 1
        Page.AutomaticSize = Enum.AutomaticSize.Y
        Page.Visible = false
        Page.Parent = Content

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Padding = UDim.new(0, 8)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Parent = Page

        -- Логика выбора
        local function select()
            if currentTab == Page then return end

            if currentTab then
                currentTab.Visible = false
                local oldBtn = TabList:FindFirstChild(currentTab.Name:gsub("Page", ""))
                if oldBtn then
                    tween(oldBtn, 0.2, {BackgroundTransparency = 1})
                    local lbl = oldBtn:FindFirstChildOfClass("TextLabel")
                    local icn = oldBtn:FindFirstChild("Icon")
                    if lbl then tween(lbl, 0.2, {TextColor3 = Sansik.Theme.TabTextColor}) end
                    if icn then tween(icn, 0.2, {ImageColor3 = Sansik.Theme.TabTextColor}) end
                end
            end

            currentTab = Page
            Page.Visible = true

            tween(TabBtn, 0.2, {BackgroundTransparency = 0, BackgroundColor3 = Sansik.Theme.TabBackgroundSelected})
            tween(BtnLabel, 0.2, {TextColor3 = Sansik.Theme.TabTextSelected})
            tween(TabIcon, 0.2, {ImageColor3 = Sansik.Theme.TabTextSelected})
        end

        TabBtn.MouseButton1Click:Connect(select)

        TabBtn.MouseEnter:Connect(function()
            if currentTab ~= Page then
                tween(TabBtn, 0.15, {BackgroundTransparency = 0.6, BackgroundColor3 = Sansik.Theme.TabBackgroundHover})
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if currentTab ~= Page then
                tween(TabBtn, 0.15, {BackgroundTransparency = 1})
            end
        end)

        if not currentTab then
            select()
        end

        -- Tab object
        local Tab = {}
        local elementOrder = 0

        local function nextOrder()
            elementOrder = elementOrder + 1
            return elementOrder
        end

        -- Здесь пока оставляем старые элементы, во второй части переделаем
        local function baseElement(height)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, height)
            frame.BackgroundColor3 = Sansik.Theme.ElementBackground
            frame.BorderSizePixel = 0
            frame.LayoutOrder = nextOrder()
            frame.Parent = Page
            corner(frame, 8)
            stroke(frame, Sansik.Theme.ElementStroke, 1, 0.5)
            return frame
        end

        function Tab:Button(props)
            local btn = baseElement(44)
            btn.Name = props.name or "Button"

            local label = Instance.new("TextLabel")
            label.Text = props.name or "Button"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 0)
            label.Size = UDim2.new(1, -28, 1, 0)
            label.Parent = btn

            btn.MouseEnter:Connect(function()
                tween(btn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover})
            end)
            btn.MouseLeave:Connect(function()
                tween(btn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground})
            end)

            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.Parent = btn

            clickable.MouseButton1Click:Connect(function()
                if props.callback then pcall(props.callback) end
            end)

            return {
                Set = function(self, newText) label.Text = newText end
            }
        end

        function Tab:Section(props)
            local section = Instance.new("Frame")
            section.Name = "Section"
            section.Size = UDim2.new(1, 0, 0, 24)
            section.BackgroundTransparency = 1
            section.LayoutOrder = nextOrder()
            section.Parent = Page

            local label = Instance.new("TextLabel")
            label.Text = props.name or "Section"
            label.Font = Enum.Font.GothamBold
            label.TextSize = 11
            label.TextColor3 = Sansik.Theme.TextSecondary
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 4, 0, 0)
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Parent = section

            return {
                Set = function(self, newName) label.Text = newName end
            }
        end

        return Tab
    end

    -- Minimize / Close
    local Minimized = false
    MinimizeBtn.MouseButton1Click:Connect(function()
        Minimized = not Minimized
        if Minimized then
            tween(Main, 0.35, {Size = UDim2.new(0, 600, 0, 56)})
        else
            tween(Main, 0.35, {Size = UDim2.new(0, 600, 0, 400)})
        end
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        tween(Main, 0.25, {Size = UDim2.new(0, 600, 0, 0), BackgroundTransparency = 1})
        task.wait(0.3)
        ScreenGui:Destroy()
    end)

    return Window
end

return Sansik
