local function getIcon(name)
    if iconsLoaded and Icons and Icons['48px'] then
        local icon = Icons['48px'][string.lower(name)]
        if icon then
            return {
                id = "rbxassetid://" .. icon[1],
                rectOffset = Vector2.new(icon[3][1], icon[3][2]),
                rectSize = Vector2.new(icon[2][1], icon[2][2]),
            }
        end
    end
    if FallbackIcons[name] then
        return { id = FallbackIcons[name], rectOffset = nil, rectSize = nil }
    end
    return nil
end

local function tween(obj, time, props, style, dir)
    return Services.TweenService:Create(
        obj,
        TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Exponential, dir or Enum.EasingDirection.Out),
        props
    )
end

local function corner(parent, radius)
    local existing = parent:FindFirstChildOfClass("UICorner")
    if existing then existing:Destroy() end
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local existing = parent:FindFirstChildOfClass("UIStroke")
    if existing then existing:Destroy() end
    local s = Instance.new("UIStroke")
    s.Color = color or Sansik.Theme.ElementStroke
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function makeDraggable(frame, dragFrame, onClick, onActivate)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local movedDistance = 0

    dragFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if onActivate then onActivate() end
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            movedDistance = 0

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if movedDistance < 5 and onClick then
                        onClick()
                    end
                end
            end)
        end
    end)

    Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            movedDistance = math.max(movedDistance, math.sqrt(delta.X^2 + delta.Y^2))
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function cacheTransparencies(root)
    for _, desc in ipairs(root:GetDescendants()) do
        if desc:IsA("Frame") or desc:IsA("TextButton") or desc:IsA("ImageButton") then
            if desc:GetAttribute("_bgOrig") == nil then
                desc:SetAttribute("_bgOrig", desc.BackgroundTransparency)
            end
        end
        if desc:IsA("TextLabel") or desc:IsA("TextBox") then
            if desc:GetAttribute("_txtOrig") == nil then
                desc:SetAttribute("_txtOrig", desc.TextTransparency)
            end
        end
        if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
            if desc:GetAttribute("_imgOrig") == nil then
                desc:SetAttribute("_imgOrig", desc.ImageTransparency)
            end
        end
        if desc:IsA("UIStroke") then
            if desc:GetAttribute("_strokeOrig") == nil then
                desc:SetAttribute("_strokeOrig", desc.Transparency)
            end
        end
        if desc:IsA("ScrollingFrame") then
            if desc:GetAttribute("_scrollBarOrig") == nil then
                desc:SetAttribute("_scrollBarOrig", desc.ScrollBarImageTransparency)
            end
        end
    end
end

local function fadeRoot(root, target, duration)
    for _, desc in ipairs(root:GetDescendants()) do
        if desc:IsA("Frame") or desc:IsA("TextButton") or desc:IsA("ImageButton") then
            local orig = desc:GetAttribute("_bgOrig")
            if orig ~= nil then
                local val = (target == 1) and 1 or orig
                tween(desc, duration, {BackgroundTransparency = val}):Play()
            end
        end
        if desc:IsA("TextLabel") or desc:IsA("TextBox") then
            local orig = desc:GetAttribute("_txtOrig")
            if orig ~= nil then
                local val = (target == 1) and 1 or orig
                tween(desc, duration, {TextTransparency = val}):Play()
            end
        end
        if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
            local orig = desc:GetAttribute("_imgOrig")
            if orig ~= nil then
                local val = (target == 1) and 1 or orig
                tween(desc, duration, {ImageTransparency = val}):Play()
            end
        end
        if desc:IsA("UIStroke") then
            local orig = desc:GetAttribute("_strokeOrig")
            if orig ~= nil then
                local val = (target == 1) and 1 or orig
                tween(desc, duration, {Transparency = val}):Play()
            end
        end
        if desc:IsA("ScrollingFrame") then
            local orig = desc:GetAttribute("_scrollBarOrig")
            if orig ~= nil then
                local val = (target == 1) and 1 or orig
                tween(desc, duration, {ScrollBarImageTransparency = val}):Play()
            end
        end
    end
end

