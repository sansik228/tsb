    FloatingBtn.ZIndex = 900
    FloatingBtn.Active = true
    FloatingBtn.Parent = ScreenGui
    corner(FloatingBtn, 25)
    stroke(FloatingBtn, Sansik.Theme.ElementStroke, 1, 0.4)

    local FloatingScale = Instance.new("UIScale")
    FloatingScale.Scale = 1
    FloatingScale.Parent = FloatingBtn

    local FloatingIcon = Instance.new("ImageLabel")
    FloatingIcon.Size = UDim2.new(0, 28, 0, 28)
    FloatingIcon.Position = UDim2.new(0, 16, 0.5, -14)
    FloatingIcon.BackgroundTransparency = 1
    FloatingIcon.ImageColor3 = Sansik.Theme.TextColor
