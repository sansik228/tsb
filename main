    FloatingIcon.Parent = FloatingBtn
    local flIco = getIcon(floatingIcon)
    if flIco then
        FloatingIcon.Image = flIco.id
        if flIco.rectOffset then FloatingIcon.ImageRectOffset = flIco.rectOffset end
        if flIco.rectSize then FloatingIcon.ImageRectSize = flIco.rectSize end
    end

    local FloatingTitle = Instance.new("TextLabel")
    FloatingTitle.Text = floatingTitle
    FloatingTitle.Font = Enum.Font.GothamBold
    FloatingTitle.TextSize = 13
    FloatingTitle.TextColor3 = Sansik.Theme.TextColor
    FloatingTitle.BackgroundTransparency = 1
    FloatingTitle.TextXAlignment = Enum.TextXAlignment.Left
