-- Sansik UI Library v1.0
-- Inspired by Rayfield, written from scratch

local Sansik = {}
Sansik.Flags = {}
Sansik.Theme = {
    TextColor = Color3.fromRGB(240, 240, 240),
    Background = Color3.fromRGB(22, 22, 26),
    Topbar = Color3.fromRGB(30, 30, 36),
    Shadow = Color3.fromRGB(10, 10, 12),
    TabBackground = Color3.fromRGB(40, 40, 48),
    TabBackgroundSelected = Color3.fromRGB(200, 200, 210),
    TabTextColor = Color3.fromRGB(200, 200, 200),
    SelectedTabTextColor = Color3.fromRGB(30, 30, 30),
    ElementBackground = Color3.fromRGB(32, 32, 38),
    ElementBackgroundHover = Color3.fromRGB(40, 40, 48),
    ElementStroke = Color3.fromRGB(50, 50, 60),
    SliderBackground = Color3.fromRGB(50, 50, 60),
    SliderProgress = Color3.fromRGB(100, 160, 255),
    ToggleEnabled = Color3.fromRGB(100, 160, 255),
    ToggleDisabled = Color3.fromRGB(80, 80, 90),
    NotificationBackground = Color3.fromRGB(25, 25, 30),
    InputBackground = Color3.fromRGB(28, 28, 34),
    InputStroke = Color3.fromRGB(55, 55, 65),
    PlaceholderColor = Color3.fromRGB(150, 150, 160),
}

local Services = {
    UserInputService = game:GetService("UserInputService"),
    TweenService = game:GetService("TweenService"),
    RunService = game:GetService("RunService"),
    Players = game:GetService("Players"),
    CoreGui = game:GetService("CoreGui"),
    HttpService = game:GetService("HttpService"),
}

local Player = Services.Players.LocalPlayer

-- Иконки Lucide (можно заменить на свои)
local Icons = {}
pcall(function()
    Icons = loadstring(game:HttpGet("https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/refs/heads/main/icons.lua"))()
end)

local function getIcon(name)
    if not Icons or not name then return nil end
    local icon = Icons['48px'][string.lower(name)]
    if not icon then return nil end
    return {
        id = "rbxassetid://" .. icon[1],
        rectOffset = Vector2.new(icon[3][1], icon[3][2]),
        rectSize = Vector2.new(icon[2][1], icon[2][2]),
    }
end

local function tween(obj, time, props, style, dir)
    Services.TweenService:Create(
        obj,
        TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Exponential, dir or Enum.EasingDirection.Out),
        props
    ):Play()
end

-- ============ УТИЛИТЫ ============

local function makeDraggable(frame, dragFrame)
    local dragging, dragStart, startPos
    
    dragFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    
    Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    Services.UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(50, 50, 60)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = parent
    return s
end

local function padding(parent, top, right, bottom, left)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, top or 0)
    p.PaddingRight = UDim.new(0, right or 0)
    p.PaddingBottom = UDim.new(0, bottom or 0)
    p.PaddingLeft = UDim.new(0, left or 0)
    p.Parent = parent
    return p
end

-- ============ БИБЛИОТЕКА ============

function Sansik:Window(props)
    props = props or {}
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "SansikUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.IgnoreGuiInset = true
    
    if gethui then
        ScreenGui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(ScreenGui)
        ScreenGui.Parent = Services.CoreGui
    else
        ScreenGui.Parent = Services.CoreGui
    end
    
    -- Main frame
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = UDim2.new(0, 500, 0, 320)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.BackgroundColor3 = Sansik.Theme.Background
    Main.BorderSizePixel = 0
    Main.Parent = ScreenGui
    corner(Main, 8)
    stroke(Main, Sansik.Theme.ElementStroke, 1, 0.5)
    
    -- Shadow
    local Shadow = Instance.new("ImageLabel")
    Shadow.Name = "Shadow"
    Shadow.Size = UDim2.new(1, 20, 1, 20)
    Shadow.Position = UDim2.new(0, -10, 0, -10)
    Shadow.BackgroundTransparency = 1
    Shadow.Image = "rbxassetid://5587865193"
    Shadow.ImageColor3 = Sansik.Theme.Shadow
    Shadow.ImageTransparency = 0.4
    Shadow.ScaleType = Enum.ScaleType.Slice
    Shadow.SliceCenter = Rect.new(10, 10, 490, 490)
    Shadow.ZIndex = -1
    Shadow.Parent = Main
    
    -- Topbar
    local Topbar = Instance.new("Frame")
    Topbar.Name = "Topbar"
    Topbar.Size = UDim2.new(1, 0, 0, 40)
    Topbar.BackgroundColor3 = Sansik.Theme.Topbar
    Topbar.BorderSizePixel = 0
    Topbar.Parent = Main
    corner(Topbar, 8)
    
    local TopbarCornerFix = Instance.new("Frame")
    TopbarCornerFix.Size = UDim2.new(1, 0, 0, 8)
    TopbarCornerFix.Position = UDim2.new(0, 0, 1, -8)
    TopbarCornerFix.BackgroundColor3 = Sansik.Theme.Topbar
    TopbarCornerFix.BorderSizePixel = 0
    TopbarCornerFix.Parent = Topbar
    
    local Title = Instance.new("TextLabel")
    Title.Name = "Title"
    Title.Text = props.title or "Sansik UI"
    Title.Font = Enum.Font.GothamMedium
    Title.TextSize = 14
    Title.TextColor3 = Sansik.Theme.TextColor
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Position = UDim2.new(0, 16, 0, 0)
    Title.Size = UDim2.new(0.5, 0, 1, 0)
    Title.Parent = Topbar
    
    local Subtitle = Instance.new("TextLabel")
    Subtitle.Name = "Subtitle"
    Subtitle.Text = props.subtitle or ""
    Subtitle.Font = Enum.Font.Gotham
    Subtitle.TextSize = 11
    Subtitle.TextColor3 = Color3.fromRGB(160, 160, 170)
    Subtitle.BackgroundTransparency = 1
    Subtitle.TextXAlignment = Enum.TextXAlignment.Right
    Subtitle.Position = UDim2.new(0.5, 0, 0, 0)
    Subtitle.Size = UDim2.new(0.5, -90, 1, 0)
    Subtitle.Parent = Topbar
    
    -- Кнопки управления
    local function topbarButton(name, xOffset, icon)
        local btn = Instance.new("TextButton")
        btn.Name = name
        btn.Size = UDim2.new(0, 28, 0, 28)
        btn.Position = UDim2.new(1, xOffset, 0.5, -14)
        btn.BackgroundTransparency = 1
        btn.Text = icon or ""
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 14
        btn.TextColor3 = Sansik.Theme.TextColor
        btn.Parent = Topbar
        corner(btn, 4)
        return btn
    end
    
    local MinimizeBtn = topbarButton("Minimize", -64, "—")
    local HideBtn = topbarButton("Hide", -32, "✕")
    
    local function hover(btn, hovered)
        tween(btn, 0.15, {BackgroundTransparency = hovered and 0.8 or 1})
    end
    
    MinimizeBtn.MouseEnter:Connect(function() hover(MinimizeBtn, true) end)
    MinimizeBtn.MouseLeave:Connect(function() hover(MinimizeBtn, false) end)
    HideBtn.MouseEnter:Connect(function() hover(HideBtn, true) end)
    HideBtn.MouseLeave:Connect(function() hover(HideBtn, false) end)
    
    -- Tab list
    local TabList = Instance.new("Frame")
    TabList.Name = "TabList"
    TabList.Size = UDim2.new(1, -20, 0, 32)
    TabList.Position = UDim2.new(0, 10, 0, 48)
    TabList.BackgroundTransparency = 1
    TabList.Parent = Main
    
    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.FillDirection = Enum.FillDirection.Horizontal
    TabListLayout.Padding = UDim.new(0, 6)
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Parent = TabList
    
    -- Content area
    local Content = Instance.new("ScrollingFrame")
    Content.Name = "Content"
    Content.Size = UDim2.new(1, -20, 1, -95)
    Content.Position = UDim2.new(0, 10, 0, 86)
    Content.BackgroundTransparency = 1
    Content.BorderSizePixel = 0
    Content.ScrollBarThickness = 2
    Content.ScrollBarImageColor3 = Sansik.Theme.ElementStroke
    Content.CanvasSize = UDim2.new(0, 0, 0, 0)
    Content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Content.Parent = Main
    
    local ContentLayout = Instance.new("UIListLayout")
    ContentLayout.Padding = UDim.new(0, 6)
    ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ContentLayout.Parent = Content
    
    -- Notifications
    local NotifFrame = Instance.new("Frame")
    NotifFrame.Name = "Notifications"
    NotifFrame.Size = UDim2.new(0, 280, 1, -40)
    NotifFrame.Position = UDim2.new(1, -300, 0, 20)
    NotifFrame.BackgroundTransparency = 1
    NotifFrame.Parent = ScreenGui
    
    local NotifLayout = Instance.new("UIListLayout")
    NotifLayout.Padding = UDim.new(0, 8)
    NotifLayout.SortOrder = Enum.SortOrder.LayoutOrder
    NotifLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    NotifLayout.Parent = NotifFrame
    
    makeDraggable(Main, Topbar)
    
    -- Minimize
    local Minimized = false
    MinimizeBtn.MouseButton1Click:Connect(function()
        Minimized = not Minimized
        if Minimized then
            tween(Main, 0.35, {Size = UDim2.new(0, 500, 0, 40)}, Enum.EasingStyle.Exponential)
        else
            tween(Main, 0.35, {Size = UDim2.new(0, 500, 0, 320)}, Enum.EasingStyle.Exponential)
        end
    end)
    
    -- Window object
    local Window = {}
    local currentTab = nil
    
    -- Notify
    function Window:Notify(props)
        props = props or {}
        
        local notif = Instance.new("Frame")
        notif.Size = UDim2.new(1, 0, 0, 0)
        notif.BackgroundColor3 = Sansik.Theme.NotificationBackground
        notif.BorderSizePixel = 0
        notif.Parent = NotifFrame
        corner(notif, 6)
        stroke(notif, Sansik.Theme.ElementStroke, 1, 0.5)
        notif.BackgroundTransparency = 1
        notif.ClipsDescendants = true
        
        local NotifTitle = Instance.new("TextLabel")
        NotifTitle.Text = props.title or "Notification"
        NotifTitle.Font = Enum.Font.GothamMedium
        NotifTitle.TextSize = 13
        NotifTitle.TextColor3 = Sansik.Theme.TextColor
        NotifTitle.BackgroundTransparency = 1
        NotifTitle.TextXAlignment = Enum.TextXAlignment.Left
        NotifTitle.Position = UDim2.new(0, 12, 0, 8)
        NotifTitle.Size = UDim2.new(1, -24, 0, 16)
        NotifTitle.TextTransparency = 1
        NotifTitle.Parent = notif
        
        local NotifContent = Instance.new("TextLabel")
        NotifContent.Text = props.content or ""
        NotifContent.Font = Enum.Font.Gotham
        NotifContent.TextSize = 11
        NotifContent.TextColor3 = Color3.fromRGB(180, 180, 190)
        NotifContent.BackgroundTransparency = 1
        NotifContent.TextXAlignment = Enum.TextXAlignment.Left
        NotifContent.TextWrapped = true
        NotifContent.Position = UDim2.new(0, 12, 0, 26)
        NotifContent.Size = UDim2.new(1, -24, 0, 30)
        NotifContent.TextTransparency = 1
        NotifContent.Parent = notif
        
        tween(notif, 0.3, {Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 0.1})
        tween(NotifTitle, 0.25, {TextTransparency = 0})
        tween(NotifContent, 0.25, {TextTransparency = 0.2})
        
        task.delay(props.duration or 4, function()
            tween(notif, 0.3, {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1})
            tween(NotifTitle, 0.2, {TextTransparency = 1})
            tween(NotifContent, 0.2, {TextTransparency = 1})
            task.wait(0.35)
            notif:Destroy()
        end)
    end
    
    -- CreateTab
    function Window:Tab(props)
        props = props or {}
        
        local name = props.name or "Tab"
        
        -- Tab button
        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = name
        TabBtn.Size = UDim2.new(0, 90, 1, 0)
        TabBtn.BackgroundColor3 = Sansik.Theme.TabBackground
        TabBtn.BorderSizePixel = 0
        TabBtn.Text = ""
        TabBtn.Parent = TabList
        corner(TabBtn, 6)
        TabBtn.BackgroundTransparency = 0.5
        
        local BtnLabel = Instance.new("TextLabel")
        BtnLabel.Text = name
        BtnLabel.Font = Enum.Font.GothamMedium
        BtnLabel.TextSize = 12
        BtnLabel.TextColor3 = Sansik.Theme.TabTextColor
        BtnLabel.BackgroundTransparency = 1
        BtnLabel.Size = UDim2.new(1, 0, 1, 0)
        BtnLabel.TextTransparency = 0.3
        BtnLabel.Parent = TabBtn
        
        -- Content page
        local Page = Instance.new("Frame")
        Page.Name = name .. "Page"
        Page.Size = UDim2.new(1, 0, 0, 0)
        Page.BackgroundTransparency = 1
        Page.AutomaticSize = Enum.AutomaticSize.Y
        Page.Visible = false
        Page.Parent = Content
        
        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Padding = UDim.new(0, 6)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Parent = Page
        
        -- Select logic
        local function select()
            if currentTab == Page then return end
            
            if currentTab then
                currentTab.Visible = false
                local oldBtn = TabList:FindFirstChild(currentTab.Name:gsub("Page", ""))
                if oldBtn then
                    tween(oldBtn, 0.2, {BackgroundTransparency = 0.5, BackgroundColor3 = Sansik.Theme.TabBackground})
                    tween(oldBtn:FindFirstChildOfClass("TextLabel"), 0.2, {TextTransparency = 0.3, TextColor3 = Sansik.Theme.TabTextColor})
                end
            end
            
            currentTab = Page
            Page.Visible = true
            
            tween(TabBtn, 0.2, {BackgroundTransparency = 0, BackgroundColor3 = Sansik.Theme.TabBackgroundSelected})
            tween(BtnLabel, 0.2, {TextTransparency = 0, TextColor3 = Sansik.Theme.SelectedTabTextColor})
        end
        
        TabBtn.MouseButton1Click:Connect(select)
        
        -- Auto-select first
        if not currentTab then
            select()
        end
        
        -- Tab object
        local Tab = {}
        
        local elementOrder = 0
        local function nextOrder()
            elementOrder = elementOrder + 1
            return elementOrder
        end
        
        -- Base element
        local function baseElement(height)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, height)
            frame.BackgroundColor3 = Sansik.Theme.ElementBackground
            frame.BorderSizePixel = 0
            frame.LayoutOrder = nextOrder()
            frame.Parent = Page
            corner(frame, 6)
            stroke(frame, Sansik.Theme.ElementStroke, 1, 0.5)
            return frame
        end
        
        -- Button
        function Tab:Button(props)
            local btn = baseElement(34)
            btn.Name = props.name or "Button"
            
            local label = Instance.new("TextLabel")
            label.Text = props.name or "Button"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Parent = btn
            
            btn.MouseEnter:Connect(function()
                tween(btn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover})
            end)
            btn.MouseLeave:Connect(function()
                tween(btn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground})
            end)
            
            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.Parent = btn
            
            clickable.MouseButton1Click:Connect(function()
                if props.callback then
                    pcall(props.callback)
                end
            end)
            
            return {
                Set = function(self, newText)
                    label.Text = newText
                end
            }
        end
        
        -- Toggle
        function Tab:Toggle(props)
            local toggle = baseElement(34)
            toggle.Name = props.name or "Toggle"
            
            local label = Instance.new("TextLabel")
            label.Text = props.name or "Toggle"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 12, 0, 0)
            label.Size = UDim2.new(1, -70, 1, 0)
            label.Parent = toggle
            
            local switchBg = Instance.new("Frame")
            switchBg.Size = UDim2.new(0, 40, 0, 20)
            switchBg.Position = UDim2.new(1, -52, 0.5, -10)
            switchBg.BackgroundColor3 = Sansik.Theme.ToggleDisabled
            switchBg.BorderSizePixel = 0
            switchBg.Parent = toggle
            corner(switchBg, 10)
            
            local indicator = Instance.new("Frame")
            indicator.Size = UDim2.new(0, 16, 0, 16)
            indicator.Position = UDim2.new(0, 2, 0.5, -8)
            indicator.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
            indicator.BorderSizePixel = 0
            indicator.Parent = switchBg
            corner(indicator, 8)
            
            local state = props.value or false
            
            local function update(animated)
                if state then
                    tween(switchBg, animated and 0.25 or 0, {BackgroundColor3 = Sansik.Theme.ToggleEnabled})
                    tween(indicator, animated and 0.25 or 0, {Position = UDim2.new(1, -18, 0.5, -8)})
                else
                    tween(switchBg, animated and 0.25 or 0, {BackgroundColor3 = Sansik.Theme.ToggleDisabled})
                    tween(indicator, animated and 0.25 or 0, {Position = UDim2.new(0, 2, 0.5, -8)})
                end
            end
            update(false)
            
            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.Parent = toggle
            
            clickable.MouseEnter:Connect(function()
                tween(toggle, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover})
            end)
            clickable.MouseLeave:Connect(function()
                tween(toggle, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground})
            end)
            
            clickable.MouseButton1Click:Connect(function()
                state = not state
                update(true)
                if props.flag then
                    Sansik.Flags[props.flag] = state
                end
                if props.callback then
                    pcall(props.callback, state)
                end
            end)
            
            local obj = {
                value = state,
                Set = function(self, v, silent)
                    state = v
                    update(true)
                    if props.flag then
                        Sansik.Flags[props.flag] = state
                    end
                    if not silent and props.callback then
                        pcall(props.callback, state)
                    end
                end
            }
            
            if props.flag then
                Sansik.Flags[props.flag] = state
            end
            
            return obj
        end
        
        -- Slider
        function Tab:Slider(props)
            local slider = baseElement(44)
            slider.Name = props.name or "Slider"
            
            local label = Instance.new("TextLabel")
            label.Text = props.name or "Slider"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 12, 0, 6)
            label.Size = UDim2.new(0.7, 0, 0, 14)
            label.Parent = slider
            
            local valueLabel = Instance.new("TextLabel")
            valueLabel.Text = tostring(props.value or props.range[1])
            valueLabel.Font = Enum.Font.Gotham
            valueLabel.TextSize = 12
            valueLabel.TextColor3 = Sansik.Theme.TextColor
            valueLabel.BackgroundTransparency = 1
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            valueLabel.Position = UDim2.new(0.7, 0, 0, 6)
            valueLabel.Size = UDim2.new(0.3, -12, 0, 14)
            valueLabel.Parent = slider
            
            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, -24, 0, 6)
            track.Position = UDim2.new(0, 12, 0, 28)
            track.BackgroundColor3 = Sansik.Theme.SliderBackground
            track.BorderSizePixel = 0
            track.Parent = slider
            corner(track, 3)
            
            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BackgroundColor3 = Sansik.Theme.SliderProgress
            fill.BorderSizePixel = 0
            fill.Parent = track
            corner(fill, 3)
            
            local min = props.range[1]
            local max = props.range[2]
            local increment = props.increment or 1
            local currentValue = props.value or min
            
            local function setValue(v, animated, silent)
                currentValue = math.clamp(v, min, max)
                local percent = (currentValue - min) / (max - min)
                tween(fill, animated and 0.15 or 0, {Size = UDim2.new(percent, 0, 1, 0)})
                valueLabel.Text = tostring(currentValue) .. (props.suffix and (" " .. props.suffix) or "")
                if props.flag then
                    Sansik.Flags[props.flag] = currentValue
                end
                if not silent and props.callback then
                    pcall(props.callback, currentValue)
                end
            end
            setValue(currentValue, false, true)
            
            local dragging = false
            local trackBtn = Instance.new("TextButton")
            trackBtn.Size = UDim2.new(1, 0, 1, 0)
            trackBtn.BackgroundTransparency = 1
            trackBtn.Text = ""
            trackBtn.Parent = track
            
            local function updateFromInput(input)
                local relativeX = input.Position.X - track.AbsolutePosition.X
                local percent = math.clamp(relativeX / track.AbsoluteSize.X, 0, 1)
                local raw = min + percent * (max - min)
                raw = math.floor(raw / increment + 0.5) * increment
                setValue(raw, true, false)
            end
            
            trackBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateFromInput(input)
                end
            end)
            
            Services.UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateFromInput(input)
                end
            end)
            
            Services.UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            
            local obj = {
                value = currentValue,
                Set = function(self, v, silent)
                    setValue(v, true, silent)
                end
            }
            
            if props.flag then
                Sansik.Flags[props.flag] = currentValue
            end
            
            return obj
        end
        
        -- Section
        function Tab:Section(props)
            local section = Instance.new("Frame")
            section.Name = "Section"
            section.Size = UDim2.new(1, 0, 0, 22)
            section.BackgroundTransparency = 1
            section.LayoutOrder = nextOrder()
            section.Parent = Page
            
            local label = Instance.new("TextLabel")
            label.Text = props.name or "Section"
            label.Font = Enum.Font.GothamBold
            label.TextSize = 11
            label.TextColor3 = Color3.fromRGB(150, 150, 160)
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Parent = section
            
            return {
                Set = function(self, newName)
                    label.Text = newName
                end
            }
        end
        
        return Tab
    end
    
    return Window
end

return Sansik
