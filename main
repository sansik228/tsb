            arrow.BackgroundTransparency = 1
            arrow.ImageColor3 = Sansik.Theme.TextSecondary
            arrow.ZIndex = 2
            arrow.Parent = dropdown
            local arrowIco = getIcon("chevron-down")
            if arrowIco then
                arrow.Image = arrowIco.id
                if arrowIco.rectOffset then arrow.ImageRectOffset = arrowIco.rectOffset end
                if arrowIco.rectSize then arrow.ImageRectSize = arrowIco.rectSize end
            end

            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.AutoButtonColor = false
            clickable.ZIndex = 3
            clickable.Parent = dropdown
            corner(clickable, 10)
            clickable.MouseEnter:Connect(function() tween(dropdown, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover}):Play() end)
            clickable.MouseLeave:Connect(function()
                if not dropdown:GetAttribute("Open") then
                    tween(dropdown, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground}):Play()
                end
            end)

            local list = Instance.new("Frame")
            list.Size = UDim2.new(0, 0, 0, 0)
            list.BackgroundColor3 = Sansik.Theme.DropdownBackground
            list.BorderSizePixel = 0
            list.Visible = false
            list.ClipsDescendants = true
            list.ZIndex = 501
            list.Parent = DropdownLayer
            corner(list, 10)
            stroke(list, Sansik.Theme.ElementStroke, 1, 0.5)

            local searchContainer = Instance.new("Frame")
            searchContainer.Size = UDim2.new(1, -16, 0, 32)
            searchContainer.Position = UDim2.new(0, 8, 0, 8)
            searchContainer.BackgroundColor3 = Sansik.Theme.DropdownOption
            searchContainer.BorderSizePixel = 0
            searchContainer.ZIndex = 502
            searchContainer.Parent = list
            corner(searchContainer, 6)

            local searchBox = Instance.new("TextBox")
            searchBox.Size = UDim2.new(1, -16, 1, 0)
            searchBox.Position = UDim2.new(0, 8, 0, 0)
            searchBox.BackgroundTransparency = 1
            searchBox.Text = ""
            searchBox.PlaceholderText = "Search..."
            searchBox.Font = Enum.Font.Gotham
            searchBox.TextSize = 12
            searchBox.TextColor3 = Sansik.Theme.TextColor
            searchBox.PlaceholderColor3 = Sansik.Theme.TextSecondary
            searchBox.TextXAlignment = Enum.TextXAlignment.Left
            searchBox.ClearTextOnFocus = false
            searchBox.ZIndex = 503
            searchBox.Parent = searchContainer

            local optionsScroll = Instance.new("ScrollingFrame")
            optionsScroll.Size = UDim2.new(1, -16, 1, -48)
            optionsScroll.Position = UDim2.new(0, 8, 0, 48)
            optionsScroll.BackgroundTransparency = 1
            optionsScroll.BorderSizePixel = 0
            optionsScroll.ScrollBarThickness = 3
            optionsScroll.ScrollBarImageColor3 = Sansik.Theme.ElementStroke
            optionsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
            optionsScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
            optionsScroll.ZIndex = 502
            optionsScroll.Parent = list

            local optionsLayout = Instance.new("UIListLayout")
            optionsLayout.Padding = UDim.new(0, 4)
            optionsLayout.SortOrder = Enum.SortOrder.LayoutOrder
            optionsLayout.Parent = optionsScroll

            local currentValues = {}
            if props.flag and type(Sansik.Flags[props.flag]) == "table" then
                currentValues = Sansik.Flags[props.flag]
            elseif props.value then
                currentValues = props.value
            end

            local optionButtons = {}

            local function updateSelected()
                if #currentValues == 0 then
                    selectedLabel.Text = "None"
                elseif #currentValues == 1 then
                    selectedLabel.Text = currentValues[1]
                else
                    selectedLabel.Text = #currentValues .. " selected"
                end
            end
            updateSelected()

            local function computeListHeight()
                local optionsCount = #optionButtons
                local neededH = 48 + optionsCount * 42 + 16
                return math.min(neededH, 200)
            end

            local function closeList()
                dropdown:SetAttribute("Open", false)
                arrow.Rotation = 0
                tween(list, 0.2, {Size = UDim2.new(0, dropdown.AbsoluteSize.X, 0, 0), BackgroundTransparency = 1}):Play()
                task.wait(0.2)
                list.Visible = false
                if openDropdownList == list then openDropdownList = nil end
                tween(dropdown, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground}):Play()
            end

            local function updateListPosition()
                local dropdownAbs = dropdown.AbsolutePosition
                local mainAbs = Main.AbsolutePosition
                local mainSize = Main.AbsoluteSize
                local padding = 10
                local listH = computeListHeight()

                local relX = dropdownAbs.X - mainAbs.X
                local relY = dropdownAbs.Y - mainAbs.Y + dropdown.AbsoluteSize.Y + 4

                if relX + dropdown.AbsoluteSize.X > mainSize.X - padding then
                    relX = mainSize.X - dropdown.AbsoluteSize.X - padding
                end
                if relX < padding then relX = padding end

                if relY + listH > mainSize.Y - padding then
                    local topY = dropdownAbs.Y - mainAbs.Y - listH - 4
                    if topY >= padding then
                        relY = topY
                    else
                        relY = mainSize.Y - listH - padding
                    end
                end
                if relY < padding then relY = padding end

                list.Position = UDim2.new(0, relX, 0, relY)
                list.Size = UDim2.new(0, dropdown.AbsoluteSize.X, 0, 0)
            end

            local function isSelected(optionName)
                for _, v in ipairs(currentValues) do
                    if v == optionName then return true end
                end
                return false
            end

            local function createOption(optionName)
                local optionBtn = Instance.new("TextButton")
                optionBtn.Name = optionName
                optionBtn.Size = UDim2.new(1, 0, 0, 38)
                optionBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                optionBtn.BorderSizePixel = 0
                optionBtn.Text = ""
                optionBtn.AutoButtonColor = false
                optionBtn.ZIndex = 503
                optionBtn.Parent = optionsScroll
                corner(optionBtn, 6)

                local optIcon = Instance.new("ImageLabel")
                optIcon.Size = UDim2.new(0, 16, 0, 16)
                optIcon.Position = UDim2.new(0, 12, 0.5, -8)
                optIcon.BackgroundTransparency = 1
                optIcon.ImageColor3 = Sansik.Theme.TextSecondary
                optIcon.ZIndex = 504
                optIcon.Parent = optionBtn

                local optLabel = Instance.new("TextLabel")
                optLabel.Text = optionName
                optLabel.Font = Enum.Font.Gotham
                optLabel.TextSize = 12
                optLabel.TextColor3 = Sansik.Theme.TextColor
                optLabel.BackgroundTransparency = 1
                optLabel.TextXAlignment = Enum.TextXAlignment.Left
                optLabel.Position = UDim2.new(0, 38, 0, 0)
                optLabel.Size = UDim2.new(1, -50, 1, 0)
                optLabel.ZIndex = 504
                optLabel.Parent = optionBtn

                local function setState(isSel)
                    if isSel then
                        local ci = getIcon("check")
                        if ci then
                            optIcon.Image = ci.id
                            if ci.rectOffset then optIcon.ImageRectOffset = ci.rectOffset end
                            if ci.rectSize then optIcon.ImageRectSize = ci.rectSize end
                        end
                        optIcon.ImageColor3 = Sansik.Theme.TextColor
                        optionBtn.BackgroundColor3 = Sansik.Theme.DropdownOptionHover
                    else
                        local si = getIcon("square")
                        if si then
                            optIcon.Image = si.id
                            if si.rectOffset then optIcon.ImageRectOffset = si.rectOffset end
                            if si.rectSize then optIcon.ImageRectSize = si.rectSize end
                        end
                        optIcon.ImageColor3 = Sansik.Theme.TextSecondary
                        optionBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                    end
                end

                setState(isSelected(optionName))

                optionBtn.MouseEnter:Connect(function()
                    if not isSelected(optionName) then
                        tween(optionBtn, 0.12, {BackgroundColor3 = Sansik.Theme.DropdownOptionHover}):Play()
                    end
                end)
                optionBtn.MouseLeave:Connect(function()
                    if not isSelected(optionName) then
                        tween(optionBtn, 0.12, {BackgroundColor3 = Sansik.Theme.DropdownOption}):Play()
                    end
                end)

                optionBtn.MouseButton1Click:Connect(function()
                    local found = false
                    for i, v in ipairs(currentValues) do
                        if v == optionName then
                            table.remove(currentValues, i)
                            found = true
                            break
                        end
                    end
                    if not found then table.insert(currentValues, optionName) end

                    for _, optBtn in ipairs(optionButtons) do
                        local ico = optBtn:FindFirstChildOfClass("ImageLabel")
                        if ico then
                            local isSel = false
                            for _, v in ipairs(currentValues) do
                                if v == optBtn.Name then isSel = true break end
                            end
                            if isSel then
                                local ci = getIcon("check")
                                if ci then
                                    ico.Image = ci.id
                                    if ci.rectOffset then ico.ImageRectOffset = ci.rectOffset end
                                    if ci.rectSize then ico.ImageRectSize = ci.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextColor
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOptionHover
                            else
                                local si = getIcon("square")
                                if si then
                                    ico.Image = si.id
                                    if si.rectOffset then ico.ImageRectOffset = si.rectOffset end
                                    if si.rectSize then ico.ImageRectSize = si.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextSecondary
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                            end
                        end
                    end

                    updateSelected()
                    if props.flag then Sansik.Flags[props.flag] = currentValues end
                    if props.callback then pcall(props.callback, currentValues) end
                end)

                return optionBtn
            end

            for _, optionName in ipairs(props.options or {}) do
                table.insert(optionButtons, createOption(optionName))
            end

            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local query = string.lower(searchBox.Text)
                for _, optBtn in ipairs(optionButtons) do
                    if string.find(string.lower(optBtn.Name), query, 1, true) then
                        optBtn.Visible = true
                    else
                        optBtn.Visible = false
                    end
                end
            end)

            clickable.MouseButton1Click:Connect(function()
                Sansik.ActiveWindow = Window
                local isOpen = dropdown:GetAttribute("Open") or false
                if isOpen then
                    closeList()
                else
                    if openDropdownList and openDropdownList ~= list then
                        openDropdownList.Visible = false
                        openDropdownList.Size = UDim2.new(0, 0, 0, 0)
                    end
                    if openColorPicker and openColorPicker.close then openColorPicker.close() end
                    dropdown:SetAttribute("Open", true)
                    arrow.Rotation = 180
                    updateListPosition()
                    list.Visible = true
                    list.BackgroundTransparency = 1
                    openDropdownList = list
                    local finalH = computeListHeight()
                    tween(list, 0.25, {Size = UDim2.new(0, dropdown.AbsoluteSize.X, 0, finalH), BackgroundTransparency = 0}):Play()
                end
            end)

            Page:GetPropertyChangedSignal("Visible"):Connect(function()
                if not Page.Visible and list.Visible then list.Visible = false end
            end)

            if props.flag then Sansik.Flags[props.flag] = currentValues end
            return {
                value = currentValues,
                Set = function(self, v, silent)
                    currentValues = v or {}
                    updateSelected()
                    for _, optBtn in ipairs(optionButtons) do
                        local ico = optBtn:FindFirstChildOfClass("ImageLabel")
                        if ico then
                            local isSel = false
                            for _, val in ipairs(currentValues) do
                                if val == optBtn.Name then isSel = true break end
                            end
                            if isSel then
                                local ci = getIcon("check")
                                if ci then
                                    ico.Image = ci.id
                                    if ci.rectOffset then ico.ImageRectOffset = ci.rectOffset end
                                    if ci.rectSize then ico.ImageRectSize = ci.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextColor
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOptionHover
                            else
                                local si = getIcon("square")
                                if si then
                                    ico.Image = si.id
                                    if si.rectOffset then ico.ImageRectOffset = si.rectOffset end
                                    if si.rectSize then ico.ImageRectSize = si.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextSecondary
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                            end
                        end
                    end
                    if props.flag then Sansik.Flags[props.flag] = currentValues end
                    if not silent and props.callback then pcall(props.callback, currentValues) end
                end
            }
        end

        function Tab:Input(props)
            local input = baseElement(46)
            input.Name = props.name or "Input"
            local label = Instance.new("TextLabel")
            label.Text = props.name or "Input"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 0)
            label.Size = UDim2.new(0.5, 0, 1, 0)
            label.Parent = input
            local inputBox = Instance.new("TextBox")
            inputBox.Size = UDim2.new(0, 200, 0, 32)
            inputBox.Position = UDim2.new(1, -214, 0.5, -16)
            inputBox.BackgroundColor3 = Sansik.Theme.InputBackground
            inputBox.BorderSizePixel = 0
            inputBox.Text = props.value or ""
            if props.flag and Sansik.Flags[props.flag] ~= nil then inputBox.Text = tostring(Sansik.Flags[props.flag]) end
            inputBox.PlaceholderText = props.placeholder or "Enter text..."
            inputBox.Font = Enum.Font.Gotham
            inputBox.TextSize = 12
            inputBox.TextColor3 = Sansik.Theme.InputText
            inputBox.PlaceholderColor3 = Sansik.Theme.InputPlaceholder
            inputBox.TextXAlignment = Enum.TextXAlignment.Left
            inputBox.ClearTextOnFocus = false
            inputBox.Parent = input
            corner(inputBox, 8)
            local inputPadding = Instance.new("UIPadding")
            inputPadding.PaddingLeft = UDim.new(0, 12)
            inputPadding.PaddingRight = UDim.new(0, 12)
            inputPadding.Parent = inputBox
            local currentValue = inputBox.Text
            inputBox.Focused:Connect(function() tween(input, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover}):Play() end)
            inputBox.FocusLost:Connect(function()
                tween(input, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground}):Play()
                currentValue = inputBox.Text
                if props.flag then Sansik.Flags[props.flag] = currentValue end
                if props.callback then pcall(props.callback, currentValue) end
                if props.clearOnFocusLost then inputBox.Text = "" end
            end)
            if props.flag then Sansik.Flags[props.flag] = currentValue end
            return {
                value = currentValue,
                Set = function(self, v, silent)
                    currentValue = v
                    inputBox.Text = v
                    if props.flag then Sansik.Flags[props.flag] = currentValue end
                    if not silent and props.callback then pcall(props.callback, currentValue) end
                end
            }
        end

        function Tab:Keybind(props)
            local keybind = baseElement(46)
            keybind.Name = props.name or "Keybind"
            local label = Instance.new("TextLabel")
            label.Text = props.name or "Keybind"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 0)
            label.Size = UDim2.new(0.5, 0, 1, 0)
            label.Parent = keybind
            local keyBtn = Instance.new("TextButton")
            keyBtn.Size = UDim2.new(0, 100, 0, 32)
            keyBtn.Position = UDim2.new(1, -114, 0.5, -16)
            keyBtn.BackgroundColor3 = Sansik.Theme.InputBackground
            keyBtn.BorderSizePixel = 0
            keyBtn.Text = props.value or "None"
            if props.flag and Sansik.Flags[props.flag] ~= nil then keyBtn.Text = Sansik.Flags[props.flag] or "None" end
            keyBtn.Font = Enum.Font.Gotham
            keyBtn.TextSize = 12
            keyBtn.TextColor3 = Sansik.Theme.InputText
            keyBtn.AutoButtonColor = false
            keyBtn.Parent = keybind
            corner(keyBtn, 8)
            local listening = false
            local currentKey = props.value or Sansik.Flags[props.flag]
            local pressCallback = props.onPress
            Services.UserInputService.InputBegan:Connect(function(input, processed)
                if processed then return end
                if listening then
                    if input.KeyCode ~= Enum.KeyCode.Unknown then
                        currentKey = input.KeyCode.Name
                        keyBtn.Text = currentKey
                        listening = false
                        keyBtn.TextColor3 = Sansik.Theme.InputText
                        tween(keyBtn, 0.15, {BackgroundColor3 = Sansik.Theme.InputBackground}):Play()
                        if props.flag then Sansik.Flags[props.flag] = currentKey end
                        if props.callback then pcall(props.callback, currentKey) end
                    end
                else
                    if currentKey and input.KeyCode.Name == currentKey then
                        if pressCallback then pcall(pressCallback) end
                    end
                end
            end)
            keyBtn.MouseButton1Click:Connect(function()
                if not listening then
                    listening = true
                    keyBtn.Text = "Press key..."
                    keyBtn.TextColor3 = Sansik.Theme.Accent
                    tween(keyBtn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover}):Play()
                else
                    listening = false
                    keyBtn.Text = currentKey or "None"
                    keyBtn.TextColor3 = Sansik.Theme.InputText
                    tween(keyBtn, 0.15, {BackgroundColor3 = Sansik.Theme.InputBackground}):Play()
                end
            end)
            keyBtn.MouseEnter:Connect(function()
                if not listening then tween(keyBtn, 0.12, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover}):Play() end
            end)
            keyBtn.MouseLeave:Connect(function()
                if not listening then tween(keyBtn, 0.12, {BackgroundColor3 = Sansik.Theme.InputBackground}):Play() end
            end)
            if props.flag then Sansik.Flags[props.flag] = currentKey end
            return {
                value = currentKey,
                Set = function(self, v, silent)
                    currentKey = v
                    keyBtn.Text = v or "None"
                    if props.flag then Sansik.Flags[props.flag] = currentKey end
                    if not silent and props.callback then pcall(props.callback, currentKey) end
                end
            }
        end

        function Tab:ColorPicker(props)
            local cp = baseElement(46)
            cp.Name = props.name or "ColorPicker"
            local label = Instance.new("TextLabel")
            label.Text = props.name or "ColorPicker"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 0)
            label.Size = UDim2.new(0.5, 0, 1, 0)
            label.Parent = cp
            local preview = Instance.new("Frame")
            preview.Size = UDim2.new(0, 60, 0, 28)
            preview.Position = UDim2.new(1, -74, 0.5, -14)
            preview.BackgroundColor3 = props.color or Color3.fromRGB(255, 255, 255)
            preview.BorderSizePixel = 0
            preview.Parent = cp
            corner(preview, 6)
            stroke(preview, Sansik.Theme.ElementStroke, 1, 0)
            local currentColor = props.color or Color3.fromRGB(255, 255, 255)
            if props.flag and typeof(Sansik.Flags[props.flag]) == "Color3" then
                currentColor = Sansik.Flags[props.flag]
                preview.BackgroundColor3 = currentColor
            end
            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.AutoButtonColor = false
            clickable.Parent = cp
            corner(clickable, 10)
            clickable.MouseEnter:Connect(function() tween(cp, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover}):Play() end)
            clickable.MouseLeave:Connect(function() tween(cp, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground}):Play() end)

            local popup = Instance.new("Frame")
            popup.Size = UDim2.new(0, 320, 0, 200)
            popup.BackgroundColor3 = Sansik.Theme.DropdownBackground
            popup.BorderSizePixel = 0
            popup.Visible = false
            popup.ClipsDescendants = false
            popup.ZIndex = 601
            popup.Parent = ColorPickerLayer
            corner(popup, 10)
            stroke(popup, Sansik.Theme.ElementStroke, 1, 0.5)

            local function updatePopupPosition()
                local cpAbs = cp.AbsolutePosition
                local mainAbs = Main.AbsolutePosition
                local mainSize = Main.AbsoluteSize
                local popupW, popupH = 320, 200
                local padding = 10
                local relX = cpAbs.X - mainAbs.X
                local relY = cpAbs.Y - mainAbs.Y + cp.AbsoluteSize.Y + 4

                if relX + popupW > mainSize.X - padding then relX = mainSize.X - popupW - padding end
                if relX < padding then relX = padding end

                -- Если не влезает снизу — сверху (но только если сверху есть место)
                if relY + popupH > mainSize.Y - padding then
                    local topY = cpAbs.Y - mainAbs.Y - popupH - 4
                    if topY >= padding then
                        relY = topY
                    else
                        relY = mainSize.Y - popupH - padding
                    end
                end
                if relY < padding then relY = padding end

                popup.Position = UDim2.new(0, relX, 0, relY)
            end

            local svArea = Instance.new("Frame")
            svArea.Size = UDim2.new(0, 150, 0, 150)
            svArea.Position = UDim2.new(0, 14, 0, 14)
            svArea.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            svArea.BorderSizePixel = 0
            svArea.ZIndex = 602
            svArea.Parent = popup
            corner(svArea, 6)
            stroke(svArea, Sansik.Theme.ElementStroke, 1, 0)

            local whiteGradient = Instance.new("Frame")
            whiteGradient.Size = UDim2.new(1, 0, 1, 0)
            whiteGradient.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            whiteGradient.BorderSizePixel = 0
            whiteGradient.ZIndex = 603
            whiteGradient.Parent = svArea
            corner(whiteGradient, 6)
            local wg = Instance.new("UIGradient")
            wg.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(1, 1),
            })
            wg.Parent = whiteGradient

            local blackGradient = Instance.new("Frame")
            blackGradient.Size = UDim2.new(1, 0, 1, 0)
            blackGradient.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            blackGradient.BorderSizePixel = 0
            blackGradient.ZIndex = 604
            blackGradient.Parent = svArea
            corner(blackGradient, 6)
            local bg = Instance.new("UIGradient")
            bg.Rotation = 90
            bg.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(1, 0),
            })
            bg.Parent = blackGradient

            local svDot = Instance.new("Frame")
            svDot.Size = UDim2.new(0, 16, 0, 16)
            svDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            svDot.BorderSizePixel = 0
            svDot.ZIndex = 605
            svDot.Parent = svArea
            corner(svDot, 8)
            stroke(svDot, Color3.fromRGB(0, 0, 0), 2, 0)

            local hueSlider = Instance.new("Frame")
            hueSlider.Size = UDim2.new(0, 16, 0, 150)
            hueSlider.Position = UDim2.new(0, 178, 0, 14)
            hueSlider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            hueSlider.BorderSizePixel = 0
            hueSlider.ZIndex = 602
            hueSlider.Parent = popup
            corner(hueSlider, 8)
            local hueGradient = Instance.new("UIGradient")
            hueGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
            })
            hueGradient.Rotation = 90
            hueGradient.Parent = hueSlider

            local hueDot = Instance.new("Frame")
            hueDot.Size = UDim2.new(0, 24, 0, 10)
            hueDot.Position = UDim2.new(0.5, -12, 0, 0)
            hueDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            hueDot.BorderSizePixel = 0
            hueDot.ZIndex = 605
            hueDot.Parent = hueSlider
            corner(hueDot, 5)
            stroke(hueDot, Color3.fromRGB(0, 0, 0), 1.5, 0)

            local previewBig = Instance.new("Frame")
            previewBig.Size = UDim2.new(0, 100, 0, 60)
            previewBig.Position = UDim2.new(0, 208, 0, 14)
            previewBig.BackgroundColor3 = currentColor
            previewBig.BorderSizePixel = 0
            previewBig.ZIndex = 602
            previewBig.Parent = popup
            corner(previewBig, 6)
            stroke(previewBig, Sansik.Theme.ElementStroke, 1, 0)

            local hexBox = Instance.new("TextBox")
            hexBox.Size = UDim2.new(0, 100, 0, 26)
            hexBox.Position = UDim2.new(0, 208, 0, 82)
            hexBox.BackgroundColor3 = Sansik.Theme.InputBackground
            hexBox.BorderSizePixel = 0
            hexBox.Text = string.format("#%02X%02X%02X", currentColor.R * 255, currentColor.G * 255, currentColor.B * 255)
            hexBox.Font = Enum.Font.Gotham
            hexBox.TextSize = 11
            hexBox.TextColor3 = Sansik.Theme.InputText
            hexBox.TextXAlignment = Enum.TextXAlignment.Center
            hexBox.ClearTextOnFocus = false
            hexBox.ZIndex = 602
            hexBox.Parent = popup
            corner(hexBox, 6)

            local alphaBox = Instance.new("TextBox")
            alphaBox.Size = UDim2.new(0, 100, 0, 26)
            alphaBox.Position = UDim2.new(0, 208, 0, 114)
            alphaBox.BackgroundColor3 = Sansik.Theme.InputBackground
            alphaBox.BorderSizePixel = 0
            alphaBox.Text = "100%"
            alphaBox.Font = Enum.Font.Gotham
            alphaBox.TextSize = 11
            alphaBox.TextColor3 = Sansik.Theme.InputText
            alphaBox.TextXAlignment = Enum.TextXAlignment.Center
            alphaBox.ClearTextOnFocus = false
            alphaBox.ZIndex = 602
            alphaBox.Parent = popup
            corner(alphaBox, 6)

            local popupClose = Instance.new("ImageButton")
            popupClose.Size = UDim2.new(0, 24, 0, 24)
            popupClose.Position = UDim2.new(1, -30, 0, 6)
            popupClose.BackgroundColor3 = Sansik.Theme.ElementBackground
            popupClose.BorderSizePixel = 0
            popupClose.AutoButtonColor = false
            popupClose.ZIndex = 610
            popupClose.Parent = popup
            corner(popupClose, 6)
            local closeIco = getIcon("x")
            if closeIco then
                popupClose.Image = closeIco.id
                if closeIco.rectOffset then popupClose.ImageRectOffset = closeIco.rectOffset end
                if closeIco.rectSize then popupClose.ImageRectSize = closeIco.rectSize end
                popupClose.ImageColor3 = Sansik.Theme.TextSecondary
            end
            popupClose.MouseEnter:Connect(function()
                tween(popupClose, 0.12, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover, ImageColor3 = Sansik.Theme.TextColor}):Play()
            end)
            popupClose.MouseLeave:Connect(function()
                tween(popupClose, 0.12, {BackgroundColor3 = Sansik.Theme.ElementBackground, ImageColor3 = Sansik.Theme.TextSecondary}):Play()
            end)

            local h, s, v = currentColor:ToHSV()
            local function updateFromHSV()
                local newColor = Color3.fromHSV(h, s, v)
                preview.BackgroundColor3 = newColor
                previewBig.BackgroundColor3 = newColor
                svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                svDot.Position = UDim2.new(s, -8, 1 - v, -8)
                hueDot.Position = UDim2.new(0.5, -12, h, -5)
                hexBox.Text = string.format("#%02X%02X%02X", newColor.R * 255, newColor.G * 255, newColor.B * 255)
                currentColor = newColor
                if props.flag then Sansik.Flags[props.flag] = newColor end
                if props.callback then pcall(props.callback, newColor) end
            end
            updateFromHSV()

            local svDragging = false
            local svInput = Instance.new("TextButton")
            svInput.Size = UDim2.new(1, 0, 1, 0)
            svInput.BackgroundTransparency = 1
            svInput.Text = ""
            svInput.AutoButtonColor = false
            svInput.ZIndex = 606
            svInput.Parent = svArea
            local function updateSV(input)
                local relX = math.clamp((input.Position.X - svArea.AbsolutePosition.X) / svArea.AbsoluteSize.X, 0, 1)
                local relY = math.clamp((input.Position.Y - svArea.AbsolutePosition.Y) / svArea.AbsoluteSize.Y, 0, 1)
                s = relX
                v = 1 - relY
                updateFromHSV()
            end
            svInput.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    svDragging = true
                    updateSV(input)
                end
            end)
            Services.UserInputService.InputChanged:Connect(function(input)
                if svDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSV(input)
                end
            end)
            Services.UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    svDragging = false
                end
            end)

            local hueDragging = false
            local hueInput = Instance.new("TextButton")
            hueInput.Size = UDim2.new(1, 0, 1, 0)
            hueInput.BackgroundTransparency = 1
            hueInput.Text = ""
            hueInput.AutoButtonColor = false
            hueInput.ZIndex = 606
            hueInput.Parent = hueSlider
            local function updateHue(input)
                local relY = math.clamp((input.Position.Y - hueSlider.AbsolutePosition.Y) / hueSlider.AbsoluteSize.Y, 0, 1)
                h = relY
                updateFromHSV()
            end
            hueInput.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    hueDragging = true
                    updateHue(input)
                end
            end)
            Services.UserInputService.InputChanged:Connect(function(input)
                if hueDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateHue(input)
                end
            end)
            Services.UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    hueDragging = false
                end
            end)

            hexBox.FocusLost:Connect(function()
                local hex = hexBox.Text:gsub("#", "")
                if #hex == 6 then
                    local r = tonumber(hex:sub(1,2), 16)
                    local g = tonumber(hex:sub(3,4), 16)
                    local b = tonumber(hex:sub(5,6), 16)
                    if r and g and b then
                        local newColor = Color3.fromRGB(r, g, b)
                        h, s, v = newColor:ToHSV()
                        updateFromHSV()
                    end
                end
            end)

            local function closePopup()
                popup.Visible = false
                tween(cp, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground}):Play()
                if openColorPicker and openColorPicker.popup == popup then openColorPicker = nil end
            end

            popupClose.MouseButton1Click:Connect(closePopup)

            clickable.MouseButton1Click:Connect(function()
                Sansik.ActiveWindow = Window
                if popup.Visible then
                    closePopup()
                else
                    if openColorPicker and openColorPicker.close then openColorPicker.close() end
                    if openDropdownList then openDropdownList.Visible = false openDropdownList = nil end
                    updatePopupPosition()
                    popup.Visible = true
                    openColorPicker = {popup = popup, close = closePopup}
                    tween(cp, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover}):Play()
                end
            end)

            Page:GetPropertyChangedSignal("Visible"):Connect(function()
                if not Page.Visible and popup.Visible then closePopup() end
            end)

            if props.flag then Sansik.Flags[props.flag] = currentColor end
            return {
                value = currentColor,
                Set = function(self, color, silent)
                    currentColor = color
                    h, s, v = color:ToHSV()
                    updateFromHSV()
                    if props.flag then Sansik.Flags[props.flag] = color end
                    if not silent and props.callback then pcall(props.callback, color) end
                end,
                GetColor = function(self) return currentColor end
            }
        end

        function Tab:Label(props)
            local labelFrame = Instance.new("Frame")
            labelFrame.Size = UDim2.new(1, 0, 0, 34)
            labelFrame.BackgroundColor3 = Sansik.Theme.ElementBackground
            labelFrame.BorderSizePixel = 0
            labelFrame.LayoutOrder = nextOrder()
            labelFrame.Parent = Page
            corner(labelFrame, 10)
            stroke(labelFrame, Sansik.Theme.ElementStroke, 1, 0.5)
            local labelIcon = Instance.new("ImageLabel")
            labelIcon.Size = UDim2.new(0, 16, 0, 16)
            labelIcon.Position = UDim2.new(0, 12, 0.5, -8)
            labelIcon.BackgroundTransparency = 1
            labelIcon.ImageColor3 = props.color or Sansik.Theme.TextSecondary
            labelIcon.Parent = labelFrame
            if props.icon then
                local ico = getIcon(props.icon)
                if ico then
                    labelIcon.Image = ico.id
                    if ico.rectOffset then labelIcon.ImageRectOffset = ico.rectOffset end
                    if ico.rectSize then labelIcon.ImageRectSize = ico.rectSize end
                end
            end
            local labelText = Instance.new("TextLabel")
            labelText.Text = props.text or "Label"
            labelText.Font = Enum.Font.GothamMedium
            labelText.TextSize = 12
            labelText.TextColor3 = props.color or Sansik.Theme.TextColor
            labelText.BackgroundTransparency = 1
            labelText.TextXAlignment = Enum.TextXAlignment.Left
            labelText.Position = UDim2.new(0, props.icon and 36 or 14, 0, 0)
            labelText.Size = UDim2.new(1, -50, 1, 0)
            labelText.Parent = labelFrame
            return { Set = function(self, newText) labelText.Text = newText end }
        end

        function Tab:Paragraph(props)
            local paraFrame = Instance.new("Frame")
            paraFrame.Size = UDim2.new(1, 0, 0, 60)
            paraFrame.BackgroundColor3 = Sansik.Theme.ElementBackground
            paraFrame.BorderSizePixel = 0
            paraFrame.AutomaticSize = Enum.AutomaticSize.Y
            paraFrame.LayoutOrder = nextOrder()
            paraFrame.Parent = Page
            corner(paraFrame, 10)
            stroke(paraFrame, Sansik.Theme.ElementStroke, 1, 0.5)
            local paraTitle = Instance.new("TextLabel")
            paraTitle.Text = props.title or "Title"
            paraTitle.Font = Enum.Font.GothamBold
            paraTitle.TextSize = 13
            paraTitle.TextColor3 = Sansik.Theme.TextColor
            paraTitle.BackgroundTransparency = 1
            paraTitle.TextXAlignment = Enum.TextXAlignment.Left
            paraTitle.Position = UDim2.new(0, 14, 0, 10)
            paraTitle.Size = UDim2.new(1, -28, 0, 16)
            paraTitle.Parent = paraFrame
            local paraContent = Instance.new("TextLabel")
            paraContent.Text = props.content or "Content"
            paraContent.Font = Enum.Font.Gotham
            paraContent.TextSize = 11
            paraContent.TextColor3 = Sansik.Theme.TextSecondary
            paraContent.BackgroundTransparency = 1
            paraContent.TextXAlignment = Enum.TextXAlignment.Left
            paraContent.TextYAlignment = Enum.TextYAlignment.Top
            paraContent.TextWrapped = true
            paraContent.Position = UDim2.new(0, 14, 0, 30)
            paraContent.Size = UDim2.new(1, -28, 0, 16)
            paraContent.AutomaticSize = Enum.AutomaticSize.Y
            paraContent.Parent = paraFrame
            return {
                Set = function(self, newTitle, newContent)
                    paraTitle.Text = newTitle or paraTitle.Text
                    paraContent.Text = newContent or paraContent.Text
                end
            }
        end

        function Tab:Divider()
            local divider = Instance.new("Frame")
            divider.Size = UDim2.new(1, -20, 0, 1)
            divider.Position = UDim2.new(0, 10, 0, 0)
            divider.BackgroundColor3 = Sansik.Theme.ElementStroke
            divider.BorderSizePixel = 0
            divider.BackgroundTransparency = 0.5
            divider.LayoutOrder = nextOrder()
            divider.Parent = Page
            return { Set = function(self, visible) divider.Visible = visible end }
        end

        function Tab:Section(props)
            local section = Instance.new("Frame")
            section.Size = UDim2.new(1, 0, 0, 22)
            section.BackgroundTransparency = 1
            section.LayoutOrder = nextOrder()
            section.Parent = Page
            local label = Instance.new("TextLabel")
            label.Text = props.name or "Section"
            label.Font = Enum.Font.GothamBold
            label.TextSize = 11
            label.TextColor3 = Sansik.Theme.TextSecondary
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 4, 0, 0)
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Parent = section
            return { Set = function(self, newName) label.Text = newName end }
        end

        return Tab
    end

    function Window:SaveConfig() return saveConfig() end
    function Window:LoadConfig() return loadConfig() end
    function Window:Show() showUI() end
    function Window:Hide() hideUI() end
    function Window:Toggle() if isHidden then showUI() else hideUI() end end

    return Window
end

-- Глобальный K — переключает ТОЛЬКО активное окно
Services.UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.K then
        local active = Sansik.ActiveWindow
        if active then
            if active:IsVisible() then
                active:Hide()
            else
                active:Show()
            end
        end
    end
end)

return Sansik
