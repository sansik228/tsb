        tween(notif, 0.35, {Size = UDim2.new(1, 0, 0, 72), BackgroundTransparency = 0.1})
        tween(NotifTitle, 0.25, {TextTransparency = 0})
        tween(NotifContent, 0.25, {TextTransparency = 0.2})
        tween(closeBtn, 0.25, {ImageTransparency = 0.4})
        tween(progressFill, duration, {Size = UDim2.new(0, 0, 1, 0)}, Enum.EasingStyle.Linear)

        closeBtn.MouseEnter:Connect(function()
            tween(closeBtn, 0.15, {ImageColor3 = Sansik.Theme.TextColor, ImageTransparency = 0, BackgroundTransparency = 0.85})
        end)
        closeBtn.MouseLeave:Connect(function()
            tween(closeBtn, 0.15, {ImageColor3 = Sansik.Theme.TextSecondary, ImageTransparency = 0.4, BackgroundTransparency = 1})
        end)

        local dismissed = false
        local function dismiss()
            if dismissed then return end
            dismissed = true
            tween(notif, 0.3, {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1})
            tween(NotifTitle, 0.2, {TextTransparency = 1})
            tween(NotifContent, 0.2, {TextTransparency = 1})
            tween(closeBtn, 0.2, {ImageTransparency = 1})
            tween(iconFrame, 0.2, {BackgroundTransparency = 1})
            tween(iconImg, 0.2, {ImageTransparency = 1})
            task.wait(0.35)
            notif:Destroy()
        end

        closeBtn.MouseButton1Click:Connect(dismiss)
        task.delay(duration, dismiss)
    end

    -- ============ TAB ============
    function Window:Tab(props)
        props = props or {}
        local name = props.name or "Tab"
        local iconName = props.icon or nil

        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = name
        TabBtn.Size = UDim2.new(1, 0, 0, 34)
        TabBtn.BackgroundColor3 = Sansik.Theme.TabBackground
        TabBtn.BorderSizePixel = 0
        TabBtn.Text = ""
        TabBtn.BackgroundTransparency = 1
        TabBtn.AutoButtonColor = false
        TabBtn.Parent = TabList
        corner(TabBtn, 8)

        local TabIcon = Instance.new("ImageLabel")
        TabIcon.Name = "Icon"
        TabIcon.Size = UDim2.new(0, 18, 0, 18)
        TabIcon.Position = UDim2.new(0, 12, 0.5, -9)
        TabIcon.BackgroundTransparency = 1
        TabIcon.ImageColor3 = Sansik.Theme.TabTextColor
        TabIcon.Parent = TabBtn

        if iconName then
            local ico = getIcon(iconName)
            if ico then
                TabIcon.Image = ico.id
                if ico.rectOffset then TabIcon.ImageRectOffset = ico.rectOffset end
                if ico.rectSize then TabIcon.ImageRectSize = ico.rectSize end
            end
        end

        local BtnLabel = Instance.new("TextLabel")
        BtnLabel.Text = name
        BtnLabel.Font = Enum.Font.GothamMedium
        BtnLabel.TextSize = 13
        BtnLabel.TextColor3 = Sansik.Theme.TabTextColor
        BtnLabel.BackgroundTransparency = 1
        BtnLabel.TextXAlignment = Enum.TextXAlignment.Left
        BtnLabel.Position = UDim2.new(0, 40, 0, 0)
        BtnLabel.Size = UDim2.new(1, -48, 1, 0)
        BtnLabel.Parent = TabBtn

        local Page = Instance.new("Frame")
        Page.Name = name .. "Page"
        Page.Size = UDim2.new(1, 0, 0, 0)
        Page.BackgroundTransparency = 1
        Page.AutomaticSize = Enum.AutomaticSize.Y
        Page.Visible = false
        Page.ClipsDescendants = false
        Page.Parent = Content

        local PageLayout = Instance.new("UIListLayout")
        PageLayout.Padding = UDim.new(0, 6)
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        PageLayout.Parent = Page

        local function closeAllDropdowns()
            if openDropdownList then
                openDropdownList.Visible = false
                openDropdownList.Size = UDim2.new(0, 0, 0, 0)
                openDropdownList = nil
            end
        end

        local function select()
            if currentTab == Page then return end

            closeAllDropdowns()

            if currentTab then
                currentTab.Visible = false
                local oldBtn = TabList:FindFirstChild(currentTab.Name:gsub("Page", ""))
                if oldBtn then
                    tween(oldBtn, 0.2, {BackgroundTransparency = 1})
                    local lbl = oldBtn:FindFirstChildOfClass("TextLabel")
                    local icn = oldBtn:FindFirstChild("Icon")
                    if lbl then tween(lbl, 0.2, {TextColor3 = Sansik.Theme.TabTextColor}) end
                    if icn then tween(icn, 0.2, {ImageColor3 = Sansik.Theme.TabTextColor}) end
                end
            end

            currentTab = Page
            Page.Visible = true

            tween(TabBtn, 0.2, {BackgroundTransparency = 0, BackgroundColor3 = Sansik.Theme.TabBackgroundSelected})
            tween(BtnLabel, 0.2, {TextColor3 = Sansik.Theme.TabTextSelected})
            tween(TabIcon, 0.2, {ImageColor3 = Sansik.Theme.TabTextSelected})
        end

        TabBtn.MouseButton1Click:Connect(select)

        TabBtn.MouseEnter:Connect(function()
            if currentTab ~= Page then
                tween(TabBtn, 0.15, {BackgroundTransparency = 0.6, BackgroundColor3 = Sansik.Theme.TabBackgroundHover})
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if currentTab ~= Page then
                tween(TabBtn, 0.15, {BackgroundTransparency = 1})
            end
        end)

        if not currentTab then
            select()
        end

        local Tab = {}
        local elementOrder = 0

        local function nextOrder()
            elementOrder = elementOrder + 1
            return elementOrder
        end

        local function baseElement(height)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 0, height)
            frame.BackgroundColor3 = Sansik.Theme.ElementBackground
            frame.BorderSizePixel = 0
            frame.LayoutOrder = nextOrder()
            frame.Parent = Page
            corner(frame, 10)
            stroke(frame, Sansik.Theme.ElementStroke, 1, 0.5)
            return frame
        end

        -- ============ BUTTON ============
        function Tab:Button(props)
            local btn = baseElement(44)
            btn.Name = props.name or "Button"

            local label = Instance.new("TextLabel")
            label.Text = props.name or "Button"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 0)
            label.Size = UDim2.new(1, -28, 1, 0)
            label.Parent = btn

            btn.MouseEnter:Connect(function()
                tween(btn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover})
            end)
            btn.MouseLeave:Connect(function()
                tween(btn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground})
            end)

            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.AutoButtonColor = false
            clickable.Parent = btn
            corner(clickable, 10)

            clickable.MouseButton1Click:Connect(function()
                if props.callback then pcall(props.callback) end
            end)

            return {
                Set = function(self, newText) label.Text = newText end
            }
        end

        -- ============ TOGGLE ============
        function Tab:Toggle(props)
            local toggle = baseElement(46)
            toggle.Name = props.name or "Toggle"

            local label = Instance.new("TextLabel")
            label.Text = props.name or "Toggle"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 6)
            label.Size = UDim2.new(1, -80, 0, 16)
            label.Parent = toggle

            local desc = Instance.new("TextLabel")
            desc.Text = props.description or ""
            desc.Font = Enum.Font.Gotham
            desc.TextSize = 11
            desc.TextColor3 = Sansik.Theme.TextSecondary
            desc.BackgroundTransparency = 1
            desc.TextXAlignment = Enum.TextXAlignment.Left
            desc.Position = UDim2.new(0, 14, 0, 24)
            desc.Size = UDim2.new(1, -80, 0, 14)
            desc.Parent = toggle

            local switchBg = Instance.new("Frame")
            switchBg.Name = "SwitchBg"
            switchBg.Size = UDim2.new(0, 48, 0, 26)
            switchBg.Position = UDim2.new(1, -62, 0.5, -13)
            switchBg.BackgroundTransparency = 1
            switchBg.BorderSizePixel = 0
            switchBg.Parent = toggle
            corner(switchBg, 13)
            local switchStroke = stroke(switchBg, Sansik.Theme.ToggleDisabledStroke, 1.5, 0)

            local indicator = Instance.new("Frame")
            indicator.Name = "Indicator"
            indicator.Size = UDim2.new(0, 20, 0, 20)
            indicator.Position = UDim2.new(0, 3, 0.5, -10)
            indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            indicator.BorderSizePixel = 0
            indicator.Parent = switchBg
            corner(indicator, 10)

            local state = props.value or false

            local function updateSwitch(animated)
                if state then
                    tween(switchStroke, animated and 0.2 or 0, {Color = Sansik.Theme.ToggleEnabledStroke, Transparency = 0.2})
                    tween(indicator, animated and 0.2 or 0, {BackgroundColor3 = Sansik.Theme.ToggleEnabled, Position = UDim2.new(1, -23, 0.5, -10)})
                else
                    tween(switchStroke, animated and 0.2 or 0, {Color = Sansik.Theme.ToggleDisabledStroke, Transparency = 0})
                    tween(indicator, animated and 0.2 or 0, {BackgroundColor3 = Color3.fromRGB(255, 255, 255), Position = UDim2.new(0, 3, 0.5, -10)})
                end
            end
            updateSwitch(false)

            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.AutoButtonColor = false
            clickable.Parent = toggle
            corner(clickable, 10)

            clickable.MouseEnter:Connect(function()
                tween(toggle, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover})
            end)
            clickable.MouseLeave:Connect(function()
                tween(toggle, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground})
            end)

            clickable.MouseButton1Click:Connect(function()
                state = not state
                updateSwitch(true)
                if props.flag then Sansik.Flags[props.flag] = state end
                if props.callback then pcall(props.callback, state) end
            end)

            local obj = {
                value = state,
                Set = function(self, v, silent)
                    state = v
                    updateSwitch(true)
                    if props.flag then Sansik.Flags[props.flag] = state end
                    if not silent and props.callback then pcall(props.callback, state) end
                end
            }

            if props.flag then Sansik.Flags[props.flag] = state end

            return obj
        end

        -- ============ SLIDER ============
        function Tab:Slider(props)
            local slider = baseElement(56)
            slider.Name = props.name or "Slider"

            local label = Instance.new("TextLabel")
            label.Text = props.name or "Slider"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 8)
            label.Size = UDim2.new(0.5, 0, 0, 16)
            label.Parent = slider

            local valueLabel = Instance.new("TextLabel")
            valueLabel.Text = tostring(props.value or props.range[1]) .. (props.suffix and (" " .. props.suffix) or "")
            valueLabel.Font = Enum.Font.Gotham
            valueLabel.TextSize = 11
            valueLabel.TextColor3 = Sansik.Theme.TextSecondary
            valueLabel.BackgroundTransparency = 1
            valueLabel.TextXAlignment = Enum.TextXAlignment.Left
            valueLabel.Position = UDim2.new(0, 14, 0, 28)
            valueLabel.Size = UDim2.new(0.5, 0, 0, 14)
            valueLabel.Parent = slider

            local track = Instance.new("Frame")
            track.Name = "Track"
            track.Size = UDim2.new(0, 240, 0, 8)
            track.Position = UDim2.new(1, -254, 0.5, -4)
            track.BackgroundColor3 = Sansik.Theme.SliderBackground
            track.BorderSizePixel = 0
            track.Parent = slider
            corner(track, 4)

            local fill = Instance.new("Frame")
            fill.Name = "Fill"
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BackgroundColor3 = Sansik.Theme.SliderProgress
            fill.BorderSizePixel = 0
            fill.Parent = track
            corner(fill, 4)

            local knob = Instance.new("Frame")
            knob.Name = "Knob"
            knob.Size = UDim2.new(0, 26, 0, 16)
            knob.Position = UDim2.new(0, 0, 0.5, -8)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.BorderSizePixel = 0
            knob.ZIndex = 2
            knob.Parent = track
            corner(knob, 8)

            local min = props.range[1]
            local max = props.range[2]
            local increment = props.increment or 1
            local currentValue = props.value or min

            local function setValue(v, animated, silent)
                currentValue = math.clamp(v, min, max)
                local percent = (currentValue - min) / (max - min)
                tween(fill, animated and 0.08 or 0, {Size = UDim2.new(percent, 0, 1, 0)})
                tween(knob, animated and 0.08 or 0, {Position = UDim2.new(percent, -13, 0.5, -8)})
                valueLabel.Text = tostring(currentValue) .. (props.suffix and (" " .. props.suffix) or "")
                if props.flag then Sansik.Flags[props.flag] = currentValue end
                if not silent and props.callback then pcall(props.callback, currentValue) end
            end
            setValue(currentValue, false, true)

            local dragging = false
            local trackBtn = Instance.new("TextButton")
            trackBtn.Size = UDim2.new(1, 0, 1, 0)
            trackBtn.BackgroundTransparency = 1
            trackBtn.Text = ""
            trackBtn.AutoButtonColor = false
            trackBtn.Parent = track
            corner(trackBtn, 4)

            local function updateFromInput(input)
                local relativeX = input.Position.X - track.AbsolutePosition.X
                local percent = math.clamp(relativeX / track.AbsoluteSize.X, 0, 1)
                local raw = min + percent * (max - min)
                raw = math.floor(raw / increment + 0.5) * increment
                setValue(raw, true, false)
            end

            trackBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateFromInput(input)
                end
            end)

            Services.UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateFromInput(input)
                end
            end)

            Services.UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            local obj = {
                value = currentValue,
                Set = function(self, v, silent)
                    setValue(v, true, silent)
                end
            }

            if props.flag then Sansik.Flags[props.flag] = currentValue end

            return obj
        end

        -- ============ DROPDOWN ============
        function Tab:Dropdown(props)
            local dropdown = baseElement(46)
            dropdown.Name = props.name or "Dropdown"
            dropdown.ClipsDescendants = false
            dropdown.ZIndex = 1

            local label = Instance.new("TextLabel")
            label.Text = props.name or "Dropdown"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 0)
            label.Size = UDim2.new(0.5, 0, 1, 0)
            label.ZIndex = 2
            label.Parent = dropdown

            local selectedLabel = Instance.new("TextLabel")
            selectedLabel.Text = props.value or "None"
            selectedLabel.Font = Enum.Font.Gotham
            selectedLabel.TextSize = 12
            selectedLabel.TextColor3 = Sansik.Theme.TextSecondary
            selectedLabel.BackgroundTransparency = 1
            selectedLabel.TextXAlignment = Enum.TextXAlignment.Right
            selectedLabel.Position = UDim2.new(0.5, 0, 0, 0)
            selectedLabel.Size = UDim2.new(0.5, -40, 1, 0)
            selectedLabel.ZIndex = 2
            selectedLabel.Parent = dropdown

            local arrow = Instance.new("ImageLabel")
            arrow.Name = "Arrow"
            arrow.Size = UDim2.new(0, 14, 0, 14)
            arrow.Position = UDim2.new(1, -24, 0.5, -7)
            arrow.BackgroundTransparency = 1
            arrow.ImageColor3 = Sansik.Theme.TextSecondary
            arrow.ZIndex = 2
            arrow.Parent = dropdown

            local arrowIco = getIcon("chevron-down")
            if arrowIco then
                arrow.Image = arrowIco.id
                if arrowIco.rectOffset then arrow.ImageRectOffset = arrowIco.rectOffset end
                if arrowIco.rectSize then arrow.ImageRectSize = arrowIco.rectSize end
            end

            local clickable = Instance.new("TextButton")
            clickable.Size = UDim2.new(1, 0, 1, 0)
            clickable.BackgroundTransparency = 1
            clickable.Text = ""
            clickable.AutoButtonColor = false
            clickable.ZIndex = 3
            clickable.Parent = dropdown
            corner(clickable, 10)

            clickable.MouseEnter:Connect(function()
                tween(dropdown, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover})
            end)
            clickable.MouseLeave:Connect(function()
                if not dropdown:GetAttribute("Open") then
                    tween(dropdown, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground})
                end
            end)

            local list = Instance.new("Frame")
            list.Name = "DropdownList"
            list.Size = UDim2.new(0, 0, 0, 0)
            list.Position = UDim2.new(0, 0, 0, 0)
            list.BackgroundColor3 = Sansik.Theme.DropdownBackground
            list.BorderSizePixel = 0
            list.Visible = false
            list.ClipsDescendants = true
            list.ZIndex = 501
            list.Parent = DropdownLayer
            corner(list, 10)
            stroke(list, Sansik.Theme.ElementStroke, 1, 0.5)

            local function updateListPosition()
                local dropdownAbs = dropdown.AbsolutePosition
                local mainAbs = Main.AbsolutePosition
                local relX = dropdownAbs.X - mainAbs.X
                local relY = dropdownAbs.Y - mainAbs.Y + dropdown.AbsoluteSize.Y + 4
                list.Position = UDim2.new(0, relX, 0, relY)
                list.Size = UDim2.new(0, dropdown.AbsoluteSize.X, 0, 0)
            end

            local searchContainer = Instance.new("Frame")
            searchContainer.Name = "SearchContainer"
            searchContainer.Size = UDim2.new(1, -16, 0, 32)
            searchContainer.Position = UDim2.new(0, 8, 0, 8)
            searchContainer.BackgroundColor3 = Sansik.Theme.DropdownOption
            searchContainer.BorderSizePixel = 0
            searchContainer.ZIndex = 502
            searchContainer.Parent = list
            corner(searchContainer, 6)

            local searchIcon = Instance.new("ImageLabel")
            searchIcon.Name = "SearchIcon"
            searchIcon.Size = UDim2.new(0, 14, 0, 14)
            searchIcon.Position = UDim2.new(0, 10, 0.5, -7)
            searchIcon.BackgroundTransparency = 1
            searchIcon.ImageColor3 = Sansik.Theme.TextSecondary
            searchIcon.ZIndex = 503
            searchIcon.Parent = searchContainer

            local searchIco = getIcon("search")
            if searchIco then
                searchIcon.Image = searchIco.id
                if searchIco.rectOffset then searchIcon.ImageRectOffset = searchIco.rectOffset end
                if searchIco.rectSize then searchIcon.ImageRectSize = searchIco.rectSize end
            end

            local searchBox = Instance.new("TextBox")
            searchBox.Name = "Search"
            searchBox.Size = UDim2.new(1, -36, 1, 0)
            searchBox.Position = UDim2.new(0, 32, 0, 0)
            searchBox.BackgroundTransparency = 1
            searchBox.Text = ""
            searchBox.PlaceholderText = "Search..."
            searchBox.Font = Enum.Font.Gotham
            searchBox.TextSize = 12
            searchBox.TextColor3 = Sansik.Theme.TextColor
            searchBox.PlaceholderColor3 = Sansik.Theme.TextSecondary
            searchBox.TextXAlignment = Enum.TextXAlignment.Left
            searchBox.ClearTextOnFocus = false
            searchBox.ZIndex = 503
            searchBox.Parent = searchContainer

            local optionsScroll = Instance.new("ScrollingFrame")
            optionsScroll.Name = "Options"
            optionsScroll.Size = UDim2.new(1, -16, 1, -48)
            optionsScroll.Position = UDim2.new(0, 8, 0, 48)
            optionsScroll.BackgroundTransparency = 1
            optionsScroll.BorderSizePixel = 0
            optionsScroll.ScrollBarThickness = 3
            optionsScroll.ScrollBarImageColor3 = Sansik.Theme.ElementStroke
            optionsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
            optionsScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
            optionsScroll.ZIndex = 502
            optionsScroll.Parent = list

            local optionsLayout = Instance.new("UIListLayout")
            optionsLayout.Padding = UDim.new(0, 4)
            optionsLayout.SortOrder = Enum.SortOrder.LayoutOrder
            optionsLayout.Parent = optionsScroll

            local currentValue = props.value or nil
            local optionButtons = {}

            local function updateSelected()
                selectedLabel.Text = currentValue or "None"
            end
            updateSelected()

            local function closeList()
                dropdown:SetAttribute("Open", false)
                arrow.Rotation = 0
                tween(list, 0.2, {Size = UDim2.new(0, dropdown.AbsoluteSize.X, 0, 0), BackgroundTransparency = 1})
                task.wait(0.2)
                list.Visible = false
                if openDropdownList == list then
                    openDropdownList = nil
                end
                tween(dropdown, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground})
            end

            local function createOption(optionName)
                local optionBtn = Instance.new("TextButton")
                optionBtn.Name = optionName
                optionBtn.Size = UDim2.new(1, 0, 0, 38)
                optionBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                optionBtn.BorderSizePixel = 0
                optionBtn.Text = ""
                optionBtn.AutoButtonColor = false
                optionBtn.ZIndex = 503
                optionBtn.Parent = optionsScroll
                corner(optionBtn, 6)

                local optIcon = Instance.new("ImageLabel")
                optIcon.Size = UDim2.new(0, 16, 0, 16)
                optIcon.Position = UDim2.new(0, 12, 0.5, -8)
                optIcon.BackgroundTransparency = 1
                optIcon.ImageColor3 = Sansik.Theme.TextSecondary
                optIcon.ZIndex = 504
                optIcon.Parent = optionBtn

                local optLabel = Instance.new("TextLabel")
                optLabel.Text = optionName
                optLabel.Font = Enum.Font.Gotham
                optLabel.TextSize = 12
                optLabel.TextColor3 = Sansik.Theme.TextColor
                optLabel.BackgroundTransparency = 1
                optLabel.TextXAlignment = Enum.TextXAlignment.Left
                optLabel.Position = UDim2.new(0, 38, 0, 0)
                optLabel.Size = UDim2.new(1, -50, 1, 0)
                optLabel.ZIndex = 504
                optLabel.Parent = optionBtn

                local function setState(isSelected)
                    if isSelected then
                        local checkIco = getIcon("check")
                        if checkIco then
                            optIcon.Image = checkIco.id
                            if checkIco.rectOffset then optIcon.ImageRectOffset = checkIco.rectOffset end
                            if checkIco.rectSize then optIcon.ImageRectSize = checkIco.rectSize end
                        end
                        optIcon.ImageColor3 = Sansik.Theme.TextColor
                        optionBtn.BackgroundColor3 = Sansik.Theme.DropdownOptionHover
                    else
                        local sqIco = getIcon("square")
                        if sqIco then
                            optIcon.Image = sqIco.id
                            if sqIco.rectOffset then optIcon.ImageRectOffset = sqIco.rectOffset end
                            if sqIco.rectSize then optIcon.ImageRectSize = sqIco.rectSize end
                        end
                        optIcon.ImageColor3 = Sansik.Theme.TextSecondary
                        optionBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                    end
                end

                setState(currentValue == optionName)

                optionBtn.MouseEnter:Connect(function()
                    if currentValue ~= optionName then
                        tween(optionBtn, 0.12, {BackgroundColor3 = Sansik.Theme.DropdownOptionHover})
                    end
                end)
                optionBtn.MouseLeave:Connect(function()
                    if currentValue ~= optionName then
                        tween(optionBtn, 0.12, {BackgroundColor3 = Sansik.Theme.DropdownOption})
                    end
                end)

                optionBtn.MouseButton1Click:Connect(function()
                    currentValue = optionName
                    updateSelected()
                    for _, optBtn in ipairs(optionButtons) do
                        local ico = optBtn:FindFirstChildOfClass("ImageLabel")
                        if ico then
                            local isSel = (optBtn.Name == currentValue)
                            if isSel then
                                local checkIco = getIcon("check")
                                if checkIco then
                                    ico.Image = checkIco.id
                                    if checkIco.rectOffset then ico.ImageRectOffset = checkIco.rectOffset end
                                    if checkIco.rectSize then ico.ImageRectSize = checkIco.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextColor
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOptionHover
                            else
                                local sqIco = getIcon("square")
                                if sqIco then
                                    ico.Image = sqIco.id
                                    if sqIco.rectOffset then ico.ImageRectOffset = sqIco.rectOffset end
                                    if sqIco.rectSize then ico.ImageRectSize = sqIco.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextSecondary
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                            end
                        end
                    end
                    if props.flag then Sansik.Flags[props.flag] = currentValue end
                    if props.callback then pcall(props.callback, currentValue) end
                    closeList()
                end)

                return optionBtn
            end

            for _, optionName in ipairs(props.options or {}) do
                table.insert(optionButtons, createOption(optionName))
            end

            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                local query = string.lower(searchBox.Text)
                for _, optBtn in ipairs(optionButtons) do
                    if string.find(string.lower(optBtn.Name), query, 1, true) then
                        optBtn.Visible = true
                    else
                        optBtn.Visible = false
                    end
                end
            end)

            clickable.MouseButton1Click:Connect(function()
                local isOpen = dropdown:GetAttribute("Open") or false
                if isOpen then
                    closeList()
                else
                    if openDropdownList and openDropdownList ~= list then
                        openDropdownList.Visible = false
                        openDropdownList.Size = UDim2.new(0, 0, 0, 0)
                    end

                    dropdown:SetAttribute("Open", true)
                    arrow.Rotation = 180
                    updateListPosition()
                    list.Visible = true
                    list.BackgroundTransparency = 1
                    openDropdownList = list
                    tween(list, 0.25, {Size = UDim2.new(0, dropdown.AbsoluteSize.X, 0, 200), BackgroundTransparency = 0})
                end
            end)

            Page:GetPropertyChangedSignal("Visible"):Connect(function()
                if not Page.Visible and list.Visible then
                    list.Visible = false
                end
            end)

            local obj = {
                value = currentValue,
                Set = function(self, v, silent)
                    currentValue = v
                    updateSelected()
                    for _, optBtn in ipairs(optionButtons) do
                        local ico = optBtn:FindFirstChildOfClass("ImageLabel")
                        if ico then
                            local isSel = (optBtn.Name == currentValue)
                            if isSel then
                                local checkIco = getIcon("check")
                                if checkIco then
                                    ico.Image = checkIco.id
                                    if checkIco.rectOffset then ico.ImageRectOffset = checkIco.rectOffset end
                                    if checkIco.rectSize then ico.ImageRectSize = checkIco.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextColor
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOptionHover
                            else
                                local sqIco = getIcon("square")
                                if sqIco then
                                    ico.Image = sqIco.id
                                    if sqIco.rectOffset then ico.ImageRectOffset = sqIco.rectOffset end
                                    if sqIco.rectSize then ico.ImageRectSize = sqIco.rectSize end
                                end
                                ico.ImageColor3 = Sansik.Theme.TextSecondary
                                optBtn.BackgroundColor3 = Sansik.Theme.DropdownOption
                            end
                        end
                    end
                    if props.flag then Sansik.Flags[props.flag] = currentValue end
                    if not silent and props.callback then pcall(props.callback, currentValue) end
                end,
                Refresh = function(self, newOptions)
                    for _, optBtn in ipairs(optionButtons) do
                        optBtn:Destroy()
                    end
                    optionButtons = {}
                    for _, optionName in ipairs(newOptions) do
                        table.insert(optionButtons, createOption(optionName))
                    end
                end
            }

            if props.flag then Sansik.Flags[props.flag] = currentValue end

            return obj
        end

        -- ============ INPUT ============
        function Tab:Input(props)
            local input = baseElement(46)
            input.Name = props.name or "Input"

            local label = Instance.new("TextLabel")
            label.Text = props.name or "Input"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 0)
            label.Size = UDim2.new(0.5, 0, 1, 0)
            label.ZIndex = 2
            label.Parent = input

            local inputBox = Instance.new("TextBox")
            inputBox.Name = "InputBox"
            inputBox.Size = UDim2.new(0, 200, 0, 32)
            inputBox.Position = UDim2.new(1, -214, 0.5, -16)
            inputBox.BackgroundColor3 = Sansik.Theme.InputBackground
            inputBox.BorderSizePixel = 0
            inputBox.Text = props.value or ""
            inputBox.PlaceholderText = props.placeholder or "Enter text..."
            inputBox.Font = Enum.Font.Gotham
            inputBox.TextSize = 12
            inputBox.TextColor3 = Sansik.Theme.InputText
            inputBox.PlaceholderColor3 = Sansik.Theme.InputPlaceholder
            inputBox.TextXAlignment = Enum.TextXAlignment.Left
            inputBox.ClearTextOnFocus = false
            inputBox.ZIndex = 3
            inputBox.Parent = input
            corner(inputBox, 8)

            local inputPadding = Instance.new("UIPadding")
            inputPadding.PaddingLeft = UDim.new(0, 12)
            inputPadding.PaddingRight = UDim.new(0, 12)
            inputPadding.Parent = inputBox

            local currentValue = props.value or ""

            inputBox.Focused:Connect(function()
                tween(input, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover})
            end)
            inputBox.FocusLost:Connect(function(enterPressed)
                tween(input, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackground})
                currentValue = inputBox.Text
                if props.flag then Sansik.Flags[props.flag] = currentValue end
                if props.callback then pcall(props.callback, currentValue) end
                if props.clearOnFocusLost then
                    inputBox.Text = ""
                end
            end)

            local obj = {
                value = currentValue,
                Set = function(self, v, silent)
                    currentValue = v
                    inputBox.Text = v
                    if props.flag then Sansik.Flags[props.flag] = currentValue end
                    if not silent and props.callback then pcall(props.callback, currentValue) end
                end
            }

            if props.flag then Sansik.Flags[props.flag] = currentValue end

            return obj
        end

        -- ============ KEYBIND ============
        function Tab:Keybind(props)
            local keybind = baseElement(46)
            keybind.Name = props.name or "Keybind"

            local label = Instance.new("TextLabel")
            label.Text = props.name or "Keybind"
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 13
            label.TextColor3 = Sansik.Theme.TextColor
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 14, 0, 0)
            label.Size = UDim2.new(0.5, 0, 1, 0)
            label.ZIndex = 2
            label.Parent = keybind

            local keyBtn = Instance.new("TextButton")
            keyBtn.Name = "KeyBtn"
            keyBtn.Size = UDim2.new(0, 100, 0, 32)
            keyBtn.Position = UDim2.new(1, -114, 0.5, -16)
            keyBtn.BackgroundColor3 = Sansik.Theme.InputBackground
            keyBtn.BorderSizePixel = 0
            keyBtn.Text = props.value or "None"
            keyBtn.Font = Enum.Font.Gotham
            keyBtn.TextSize = 12
            keyBtn.TextColor3 = Sansik.Theme.InputText
            keyBtn.AutoButtonColor = false
            keyBtn.ZIndex = 3
            keyBtn.Parent = keybind
            corner(keyBtn, 8)

            local listening = false
            local currentKey = props.value or nil

            local inputConnection = Services.UserInputService.InputBegan:Connect(function(input, processed)
                if processed then return end
                if listening then
                    if input.KeyCode ~= Enum.KeyCode.Unknown then
                        currentKey = input.KeyCode.Name
                        keyBtn.Text = currentKey
                        listening = false
                        keyBtn.TextColor3 = Sansik.Theme.InputText
                        tween(keyBtn, 0.15, {BackgroundColor3 = Sansik.Theme.InputBackground})
                        if props.flag then Sansik.Flags[props.flag] = currentKey end
                        if props.callback then pcall(props.callback, currentKey) end
                    end
                else
                    if currentKey and input.KeyCode.Name == currentKey then
                        if props.onPress then pcall(props.onPress) end
                    end
                end
            end)

            keyBtn.MouseButton1Click:Connect(function()
                if not listening then
                    listening = true
                    keyBtn.Text = "Press key..."
                    keyBtn.TextColor3 = Sansik.Theme.Accent
                    tween(keyBtn, 0.15, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover})
                else
                    listening = false
                    keyBtn.Text = currentKey or "None"
                    keyBtn.TextColor3 = Sansik.Theme.InputText
                    tween(keyBtn, 0.15, {BackgroundColor3 = Sansik.Theme.InputBackground})
                end
            end)

            keyBtn.MouseEnter:Connect(function()
                if not listening then
                    tween(keyBtn, 0.12, {BackgroundColor3 = Sansik.Theme.ElementBackgroundHover})
                end
            end)
            keyBtn.MouseLeave:Connect(function()
                if not listening then
                    tween(keyBtn, 0.12, {BackgroundColor3 = Sansik.Theme.InputBackground})
                end
            end)

            local obj = {
                value = currentKey,
                Set = function(self, v, silent)
                    currentKey = v
                    keyBtn.Text = v or "None"
                    if props.flag then Sansik.Flags[props.flag] = currentKey end
                    if not silent and props.callback then pcall(props.callback, currentKey) end
                end
            }

            if props.flag then Sansik.Flags[props.flag] = currentKey end

            return obj
        end

        -- ============ LABEL ============
        function Tab:Label(props)
            local labelFrame = Instance.new("Frame")
            labelFrame.Name = props.name or "Label"
            labelFrame.Size = UDim2.new(1, 0, 0, 34)
            labelFrame.BackgroundColor3 = Sansik.Theme.ElementBackground
            labelFrame.BorderSizePixel = 0
            labelFrame.LayoutOrder = nextOrder()
            labelFrame.Parent = Page
            corner(labelFrame, 10)
            stroke(labelFrame, Sansik.Theme.ElementStroke, 1, 0.5)

            local labelIcon = Instance.new("ImageLabel")
            labelIcon.Size = UDim2.new(0, 16, 0, 16)
            labelIcon.Position = UDim2.new(0, 12, 0.5, -8)
            labelIcon.BackgroundTransparency = 1
            labelIcon.ImageColor3 = props.color or Sansik.Theme.TextSecondary
            labelIcon.Parent = labelFrame

            if props.icon then
                local ico = getIcon(props.icon)
                if ico then
                    labelIcon.Image = ico.id
                    if ico.rectOffset then labelIcon.ImageRectOffset = ico.rectOffset end
                    if ico.rectSize then labelIcon.ImageRectSize = ico.rectSize end
                end
            end

            local labelText = Instance.new("TextLabel")
            labelText.Text = props.text or "Label"
            labelText.Font = Enum.Font.GothamMedium
            labelText.TextSize = 12
            labelText.TextColor3 = props.color or Sansik.Theme.TextColor
            labelText.BackgroundTransparency = 1
            labelText.TextXAlignment = Enum.TextXAlignment.Left
            labelText.Position = UDim2.new(0, props.icon and 36 or 14, 0, 0)
            labelText.Size = UDim2.new(1, -50, 1, 0)
            labelText.Parent = labelFrame

            return {
                Set = function(self, newText)
                    labelText.Text = newText
                end
            }
        end

        -- ============ PARAGRAPH ============
        function Tab:Paragraph(props)
            local paraFrame = Instance.new("Frame")
            paraFrame.Name = props.name or "Paragraph"
            paraFrame.Size = UDim2.new(1, 0, 0, 60)
            paraFrame.BackgroundColor3 = Sansik.Theme.ElementBackground
            paraFrame.BorderSizePixel = 0
            paraFrame.AutomaticSize = Enum.AutomaticSize.Y
            paraFrame.LayoutOrder = nextOrder()
            paraFrame.Parent = Page
            corner(paraFrame, 10)
            stroke(paraFrame, Sansik.Theme.ElementStroke, 1, 0.5)

            local paraTitle = Instance.new("TextLabel")
            paraTitle.Text = props.title or "Title"
            paraTitle.Font = Enum.Font.GothamBold
            paraTitle.TextSize = 13
            paraTitle.TextColor3 = Sansik.Theme.TextColor
            paraTitle.BackgroundTransparency = 1
            paraTitle.TextXAlignment = Enum.TextXAlignment.Left
            paraTitle.Position = UDim2.new(0, 14, 0, 10)
            paraTitle.Size = UDim2.new(1, -28, 0, 16)
            paraTitle.Parent = paraFrame

            local paraContent = Instance.new("TextLabel")
            paraContent.Text = props.content or "Content"
            paraContent.Font = Enum.Font.Gotham
            paraContent.TextSize = 11
            paraContent.TextColor3 = Sansik.Theme.TextSecondary
            paraContent.BackgroundTransparency = 1
            paraContent.TextXAlignment = Enum.TextXAlignment.Left
            paraContent.TextYAlignment = Enum.TextYAlignment.Top
            paraContent.TextWrapped = true
            paraContent.Position = UDim2.new(0, 14, 0, 30)
            paraContent.Size = UDim2.new(1, -28, 0, 16)
            paraContent.AutomaticSize = Enum.AutomaticSize.Y
            paraContent.Parent = paraFrame

            return {
                Set = function(self, newTitle, newContent)
                    paraTitle.Text = newTitle or paraTitle.Text
                    paraContent.Text = newContent or paraContent.Text
                end
            }
        end

        -- ============ DIVIDER ============
        function Tab:Divider()
            local divider = Instance.new("Frame")
            divider.Name = "Divider"
            divider.Size = UDim2.new(1, -20, 0, 1)
            divider.Position = UDim2.new(0, 10, 0, 0)
            divider.BackgroundColor3 = Sansik.Theme.ElementStroke
            divider.BorderSizePixel = 0
            divider.BackgroundTransparency = 0.5
            divider.LayoutOrder = nextOrder()
            divider.Parent = Page

            return {
                Set = function(self, visible)
                    divider.Visible = visible
                end
            }
        end

        -- ============ SECTION ============
        function Tab:Section(props)
            local section = Instance.new("Frame")
            section.Name = "Section"
            section.Size = UDim2.new(1, 0, 0, 22)
            section.BackgroundTransparency = 1
            section.LayoutOrder = nextOrder()
            section.Parent = Page

            local label = Instance.new("TextLabel")
            label.Text = props.name or "Section"
            label.Font = Enum.Font.GothamBold
            label.TextSize = 11
            label.TextColor3 = Sansik.Theme.TextSecondary
            label.BackgroundTransparency = 1
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Position = UDim2.new(0, 4, 0, 0)
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Parent = section

            return {
                Set = function(self, newName) label.Text = newName end
            }
        end

        return Tab
    end

    -- Minimize / Close
    local Minimized = false

    local function setContentVisible(visible)
        Sidebar.Visible = visible
        Content.Visible = visible
        TopbarDivider.Visible = visible
        BottomLeftFix.Visible = visible
        BottomRightFix.Visible = visible
    end

    MinimizeBtn.MouseButton1Click:Connect(function()
        Minimized = not Minimized
        if Minimized then
            if openDropdownList then
                openDropdownList.Visible = false
                openDropdownList = nil
            end
            setContentVisible(false)
            tween(Main, 0.35, {Size = UDim2.new(0, 600, 0, 56)})
        else
            tween(Main, 0.35, {Size = UDim2.new(0, 600, 0, 400)})
            task.wait(0.15)
            setContentVisible(true)
        end
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        setContentVisible(false)
        if openDropdownList then
            openDropdownList.Visible = false
            openDropdownList = nil
        end
        Main.ClipsDescendants = true
        tween(Main, 0.25, {Size = UDim2.new(0, 600, 0, 0), BackgroundTransparency = 1})
        task.wait(0.3)
        ScreenGui:Destroy()
    end)

    return Window
end

return Sansik
