-- ============ ИКОНКИ ============
local Icons = {}
local iconsLoaded = false

pcall(function()
    local src = game:HttpGet("https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/refs/heads/main/icons.lua")
    Icons = loadstring(src)()
    iconsLoaded = true
end)

local FallbackIcons = {
    home = "rbxassetid://10709790398",
    shield = "rbxassetid://10709794005",
    crosshair = "rbxassetid://10709788764",
    smile = "rbxassetid://10709792413",
    box = "rbxassetid://10709787512",
    search = "rbxassetid://10709789252",
    settings = "rbxassetid://10709791120",
    minus = "rbxassetid://10709789939",
    x = "rbxassetid://10709794675",
    check = "rbxassetid://10709788428",
    info = "rbxassetid://10709790910",
    ["alert-triangle"] = "rbxassetid://10709787142",
    ["chevron-down"] = "rbxassetid://10709788988",
    ["chevron-up"] = "rbxassetid://10709789084",
    square = "rbxassetid://10709793324",
    keyboard = "rbxassetid://10709790676",
}

local function getIcon(name)
    if iconsLoaded and Icons and Icons['48px'] then
        local icon = Icons['48px'][string.lower(name)]
        if icon then
            return {
                id = "rbxassetid://" .. icon[1],
                rectOffset = Vector2.new(icon[3][1], icon[3][2]),
                rectSize = Vector2.new(icon[2][1], icon[2][2]),
            }
        end
    end
    if FallbackIcons[name] then
        return { id = FallbackIcons[name], rectOffset = nil, rectSize = nil }
    end
    return nil
end

local function tween(obj, time, props, style, dir)
    Services.TweenService:Create(
        obj,
        TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Exponential, dir or Enum.EasingDirection.Out),
        props
    ):Play()
end

local function corner(parent, radius)
    local existing = parent:FindFirstChildOfClass("UICorner")
    if existing then existing:Destroy() end
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local existing = parent:FindFirstChildOfClass("UIStroke")
    if existing then existing:Destroy() end
    local s = Instance.new("UIStroke")
    s.Color = color or Sansik.Theme.ElementStroke
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function makeDraggable(frame, dragFrame)
    local dragging, dragStart, startPos

    dragFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    Services.UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

