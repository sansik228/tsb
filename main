        btn.MouseEnter:Connect(function()
            tween(btn, 0.15, {BackgroundTransparency = 0.85, ImageColor3 = Sansik.Theme.TextColor}):Play()
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, 0.15, {BackgroundTransparency = 1, ImageColor3 = Sansik.Theme.TextSecondary}):Play()
        end)
        return btn
    end

