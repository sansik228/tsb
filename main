        iconImg.Parent = iconFrame

        local iconName = props.icon or "info"
        local ico = getIcon(iconName)
        if ico then
            iconImg.Image = ico.id
            if ico.rectOffset then iconImg.ImageRectOffset = ico.rectOffset end
            if ico.rectSize then iconImg.ImageRectSize = ico.rectSize end
