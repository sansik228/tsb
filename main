        if closeIco then
            closeBtn.Image = closeIco.id
            if closeIco.rectOffset then closeBtn.ImageRectOffset = closeIco.rectOffset end
            if closeIco.rectSize then closeBtn.ImageRectSize = closeIco.rectSize end
