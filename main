        keyBtn.MouseButton1Click:Connect(function()
            for _, validKey in ipairs(validKeys) do
                if keyInput.Text == validKey then
                    keySuccess = true
                    keyGui:Destroy()
                    return
                end
            end
            keyInput.Text = ""
            keyInput.PlaceholderText = "Неверный ключ!"
