    local function topbarButton(name, xOffset, iconName)
        local btn = Instance.new("ImageButton")
        btn.Name = name
        btn.Size = UDim2.new(0, 30, 0, 30)
        btn.Position = UDim2.new(1, xOffset, 0.5, -15)
        btn.BackgroundTransparency = 1
        btn.Image = ""
        btn.ZIndex = 2
        btn.Parent = Topbar
        corner(btn, 8)

        if iconName then
            local ico = getIcon(iconName)
            if ico then
                btn.Image = ico.id
                if ico.rectOffset then btn.ImageRectOffset = ico.rectOffset end
                if ico.rectSize then btn.ImageRectSize = ico.rectSize end
                btn.ImageColor3 = Sansik.Theme.TextSecondary
            end
        end

        btn.MouseEnter:Connect(function()
            tween(btn, 0.15, {BackgroundTransparency = 0.85, ImageColor3 = Sansik.Theme.TextColor})
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, 0.15, {BackgroundTransparency = 1, ImageColor3 = Sansik.Theme.TextSecondary})
        end)

        return btn
    end

